#!/usr/bin/env python3
"""Download and verify the upstream tarballs of a Motanka source package.

Usage:
  stack/fetch-sources [--components FILE] [--out DIR] [--update-checksums] [--version V]
  stack/fetch-sources [--components FILE] --check

Reads a components file (default stack/components.tsv, the Stack). For
every component it downloads the tarball into
DIR/downloads/<name>-<version>.tar.<ext> (skipped when a file with the
pinned SHA-256 is already there), verifies its SHA-256 and checks that it
holds exactly one top-level folder with no absolute or '..' paths (a
component of build "files" may instead hold its files at the top level,
as font release archives do; dpkg-source unpacks such a component as it
is, and the package's build looks its files up by name). When all
components pass, the source package's files in DIR/orig/ are rebuilt with
one hard link (or copy) per component, named as dpkg-source 3.0 (quilt)
expects:

  <source>_<V>.orig-<name>.tar.<ext>

<source> comes from the file's "#@source <name>" line (default
motanka-stack). <V> is the Motanka version (default: first line of
packaging/VERSION). Files of other source packages in DIR/orig/ are left
alone, so one DIR serves every components file. The main orig tarball
(<source>_<V>.orig.tar.xz) is made by packaging/build.sh from the package
folder, like for every other package, so it always matches the folder.

A component of build "cargo" (a Rust program) also gets its crates. After
its tarball passed the checks above, the tool reads <top>/Cargo.lock from
inside the tarball and refuses (exit 1) every package whose source is not
the crates.io registry: git sources, other registries, and packages without
a source that no Cargo.toml in the tarball names (path dependencies outside
the source). Each crates.io crate (one per name and version) is downloaded
into DIR/downloads/crates/<crate>-<version>.crate (skipped when a file with
the lock file's SHA-256 is already there), checked against the SHA-256 that
Cargo.lock records for it (exit 6 on a mismatch, as for tarballs) and
checked to hold one folder <crate>-<version>/ with only files and folders
and no absolute or '..' paths. The crates are then packed into one more
component of the source package:

  <source>_<V>.orig-<name>-crates.tar.gz

whose single top folder <name>-crates/ holds <crate>-<version>/ for every
crate, plus the .cargo-checksum.json that Cargo's directory source needs
({"files":{},"package":"<crate sha256>"}, as Debian's dh-cargo writes it).
The tarball is reproducible: members sorted by path, mtime 0, owner and
group 0 with empty names, file modes from the crate, folders 0755, and a
gzip header with mtime 0 and no file name, so two runs give the same bytes.
It has no pin of its own: every crate in it is checked against Cargo.lock,
which is inside the pinned component tarball. Crates are downloaded from
https://static.crates.io/crates/<crate>/<crate>-<version>.crate; the
environment variable MOTANKA_CRATES_BASE_URL (an https:// or file:// URL)
replaces https://static.crates.io/crates, for the unit tests. A component
may not be called <name>-crates when a cargo component <name> exists.

A component of build "file" is one file, not a tarball: an upstream
release binary, for example. Its URL's last path segment (letters,
digits, '.', '_', '+' and '-') is the file name. It is downloaded into
DIR/downloads/<name>-<version>.<file name> and pinned by SHA-256 like a
tarball (exit 6 on a mismatch, and the download is deleted). Because
dpkg-source 3.0 (quilt) takes only tarballs as orig components, the tool
packs it into

  <source>_<V>.orig-<name>.tar.gz

with the single top folder <name>/ holding the file under its file name,
mode 0644 (the package build installs it with the mode it needs). The
tarball is reproducible in the same way as a crates tarball.

Directives (lines starting with '#@', before or between components):
  #@source <name>           source package the components belong to
  #@packages <pkg>...       binary packages the package field may name
                            ('-' is always allowed)
A file without directives is the Stack: source motanka-stack, packages
motanka-stack-libs, motanka-stack-hyprland and motanka-stack-tools.

Options:
  --components FILE    read (and update) FILE instead of stack/components.tsv
                       (--tsv FILE is the same option)
  --out DIR            output folder (default ~/.cache/motanka-vm/stack-src-tarballs)
  --update-checksums   write the computed SHA-256 into the components file
                       for entries whose sha256 field is '-'. Pinned entries
                       are never changed; a mismatch is still an error.
  --version V          Motanka version for the orig file names
  --check              validate the components file only; no network, no writes

Exit codes: 0 success, 1 a component is unpinned, failed to download or is
malformed (for cargo components also: no Cargo.lock, a package from a
source other than crates.io, a malformed crate; for file components: an
empty file), 2 usage error, invalid components.tsv or invalid
MOTANKA_CRATES_BASE_URL, 6 checksum mismatch of a tarball, a file or a
crate.

It only downloads and verifies: it installs nothing and runs nothing it
downloads, so it may run on the development host or in a test VM. It
writes only inside DIR and, with --update-checksums, the components file.
Written in Python because the host tool set has python3 but no curl, and
the tarball checks need a tar reader. Cargo.lock is read with tomllib
(Python 3.11 or later).
"""

import argparse
import gzip
import hashlib
import io
import json
import os
import re
import shutil
import sys
import tarfile
import time
import urllib.error
import urllib.request
import zlib

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
TSV = os.path.join(HERE, "components.tsv")
VERSION_FILE = os.path.join(REPO, "packaging", "VERSION")
DEFAULT_SOURCE = "motanka-stack"
DEFAULT_OUT = os.path.join(os.path.expanduser("~"), ".cache", "motanka-vm", "stack-src-tarballs")

FIELDS = ("name", "version", "url", "sha256", "build", "suites", "package")
# qt: a Qt submodule (motanka-qt6). source: not built on its own; another
# component's build uses its folder (libdwarf-lite for cpptrace). files:
# plain files installed as they are (fonts, motanka-fonts); the tarball may
# hold them without a top-level folder. cargo: a Rust program built offline
# with the archive's cargo; its crates become the component <name>-crates.
# file: one file that is not a tarball (an upstream release binary,
# motanka-apps), packed into the orig component <name>.
BUILDS = {"cmake", "meson", "autotools", "lua", "python-meson", "headers", "cmake-tool", "qt", "source", "files", "cargo", "file"}
CARGO_BUILDS = {"cargo"}
FILE_BUILDS = {"file"}
FILE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*$")
CRATES_SUFFIX = "-crates"
CRATES_IO_SOURCE = "registry+https://github.com/rust-lang/crates.io-index"
CRATES_BASE_ENV = "MOTANKA_CRATES_BASE_URL"
DEFAULT_CRATES_BASE = "https://static.crates.io/crates"
CRATE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")
CRATE_VERSION_RE = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+(?:[-+][0-9A-Za-z.+-]+)?$")
FLAT_OK_BUILDS = {"files"}
SUITES = {"noble", "resolute", "both"}
DEFAULT_PACKAGES = {"-", "motanka-stack-libs", "motanka-stack-hyprland", "motanka-stack-tools"}
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
MOTANKA_RE = re.compile(r"^motanka(-[a-z0-9][a-z0-9+.-]*)?$")
DIRECTIVE_RE = re.compile(r"^#@([a-z]+)(?:[ \t]+(.*))?$")
VERSION_RE = re.compile(r"^[0-9][A-Za-z0-9.+~]*$")
SHA_RE = re.compile(r"^[0-9a-f]{64}$")
EXTS = ((".tar.gz", "gz"), (".tgz", "gz"), (".tar.xz", "xz"), (".tar.bz2", "bz2"))

ATTEMPTS = 5
TIMEOUT = 60
USER_AGENT = "motanka-fetch-sources/1 (+https://github.com/digitwolf/motanka)"

EXIT_PROBLEM = 1
EXIT_USAGE = 2
EXIT_MISMATCH = 6


class TsvError(Exception):
    pass


def log(msg):
    print(f"fetch-sources: {msg}", file=sys.stderr)


def ext_of(url):
    path = url.split("?", 1)[0]
    for suffix, ext in EXTS:
        if path.endswith(suffix):
            return ext
    raise TsvError(f"cannot tell the compression of {url} (expected .tar.gz, .tgz, .tar.xz or .tar.bz2)")


def file_name_of(where, url):
    """The file name of a component of build "file": the last segment of
    the URL's path."""
    rest = url.split("?", 1)[0].split("#", 1)[0][len("https://"):]
    name = rest.rsplit("/", 1)[-1] if "/" in rest else ""
    if not FILE_NAME_RE.match(name):
        raise TsvError(f"{where}: a component of build file needs a URL whose last path segment is a file name, got '{url}'")
    return name


def parse_directive(where, line, meta):
    m = DIRECTIVE_RE.match(line.rstrip())
    if not m:
        raise TsvError(f"{where}: malformed directive '{line.strip()}' (expected '#@<name> <value>')")
    key, value = m.group(1), (m.group(2) or "").split()
    if key in meta["seen"]:
        raise TsvError(f"{where}: duplicate #@{key} directive")
    meta["seen"].add(key)
    if key == "source":
        if len(value) != 1 or not MOTANKA_RE.match(value[0]):
            raise TsvError(f"{where}: #@source needs one source package name starting with 'motanka'")
        meta["source"] = value[0]
    elif key == "packages":
        if not value:
            raise TsvError(f"{where}: #@packages needs at least one package name")
        for pkg in value:
            if pkg != "-" and not MOTANKA_RE.match(pkg):
                raise TsvError(f"{where}: #@packages: '{pkg}' is not a Motanka package name")
        meta["packages"] = set(value) | {"-"}
    else:
        raise TsvError(f"{where}: unknown directive #@{key} (known: #@source, #@packages)")


def parse_tsv(path):
    """Returns (lines, components, meta). lines keeps the file for
    rewriting; each component is a dict with the FIELDS plus 'line' and
    'ext'; meta has 'source' and 'packages' from the directives."""
    with open(path, encoding="utf-8") as f:
        lines = f.read().split("\n")
    comps = []
    seen = set()
    meta = {"source": DEFAULT_SOURCE, "packages": set(DEFAULT_PACKAGES), "seen": set()}
    for i, line in enumerate(lines):
        if line.startswith("#@"):
            parse_directive(f"{path}:{i + 1}", line, meta)
            continue
        if not line.strip() or line.startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) != len(FIELDS):
            raise TsvError(f"{path}:{i + 1}: expected {len(FIELDS)} tab-separated fields, found {len(parts)}")
        c = dict(zip(FIELDS, parts))
        where = f"{path}:{i + 1}"
        if not NAME_RE.match(c["name"]):
            raise TsvError(f"{where}: invalid name '{c['name']}'")
        if c["name"] in seen:
            raise TsvError(f"{where}: duplicate component '{c['name']}'")
        seen.add(c["name"])
        if not VERSION_RE.match(c["version"]):
            raise TsvError(f"{where}: invalid version '{c['version']}'")
        if not c["url"].startswith("https://"):
            raise TsvError(f"{where}: the URL must use https")
        if c["sha256"] != "-" and not SHA_RE.match(c["sha256"]):
            raise TsvError(f"{where}: sha256 must be 64 lowercase hex digits or '-'")
        if c["build"] not in BUILDS:
            raise TsvError(f"{where}: unknown build system '{c['build']}'")
        if c["suites"] not in SUITES:
            raise TsvError(f"{where}: suites must be noble, resolute or both")
        if c["build"] in FILE_BUILDS:
            c["file"] = file_name_of(where, c["url"])
            c["ext"] = "gz"
        else:
            c["ext"] = ext_of(c["url"])
        c["line"] = i
        comps.append(c)
    for c in comps:
        if c["package"] not in meta["packages"]:
            allowed = ", ".join(sorted(meta["packages"]))
            raise TsvError(f"{path}:{c['line'] + 1}: unknown package '{c['package']}' (allowed: {allowed})")
    for c in comps:
        if c["build"] in CARGO_BUILDS and c["name"] + CRATES_SUFFIX in seen:
            raise TsvError(
                f"{path}:{c['line'] + 1}: the crates of cargo component '{c['name']}' are the component "
                f"'{c['name']}{CRATES_SUFFIX}', which the file also lists"
            )
    if not comps:
        raise TsvError(f"{path}: no components")
    del meta["seen"]
    return lines, comps, meta


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            block = f.read(1 << 20)
            if not block:
                break
            h.update(block)
    return h.hexdigest()


def download(url, dest):
    tmp = dest + ".part"
    last = None
    for attempt in range(1, ATTEMPTS + 1):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp, open(tmp, "wb") as out:
                shutil.copyfileobj(resp, out, 1 << 20)
            os.replace(tmp, dest)
            return
        except (urllib.error.URLError, OSError) as e:
            last = e
            try:
                os.unlink(tmp)
            except FileNotFoundError:
                pass
            if attempt < ATTEMPTS:
                wait = 5 * attempt
                log(f"download of {url} failed ({e}); retry {attempt}/{ATTEMPTS - 1} in {wait} s")
                time.sleep(wait)
    raise OSError(f"download of {url} failed after {ATTEMPTS} attempts: {last}")


def check_tar(path, flat_ok=False):
    """Returns None if the tarball is well-formed, else a reason. With
    flat_ok, regular files at the top level are allowed too, but then the
    tarball may hold no folder and no link at all, so its unpacked tree
    is exactly those files."""
    tops = set()
    flat = []
    others = []
    try:
        with tarfile.open(path, "r:*") as tar:
            for m in tar:
                name = m.name
                if name.startswith("/") or ".." in name.split("/"):
                    return f"unsafe member path '{name}'"
                if m.isdev():
                    return f"device file '{name}'"
                parts = [p for p in name.split("/") if p not in ("", ".")]
                if not parts:
                    continue
                if len(parts) == 1 and not m.isdir():
                    if not flat_ok:
                        return f"file '{name}' at the top level"
                    if not m.isfile():
                        return f"'{name}' at the top level is not a regular file"
                    flat.append(name)
                    continue
                others.append(name)
                tops.add(parts[0])
    except (tarfile.TarError, OSError, EOFError) as e:
        return f"unreadable tarball: {e}"
    if flat:
        if others:
            return f"files at the top level next to folders or nested paths ('{others[0]}')"
        return None
    if len(tops) != 1:
        return f"expected one top-level folder, found {len(tops)}: {', '.join(sorted(tops)[:5])}"
    return None


# --- cargo components -------------------------------------------------------


def crates_base_url():
    base = os.environ.get(CRATES_BASE_ENV) or DEFAULT_CRATES_BASE
    if not (base.startswith("https://") or base.startswith("file://")):
        raise TsvError(f"{CRATES_BASE_ENV} must be an https:// or file:// URL, got '{base}'")
    return base.rstrip("/")


def load_tomllib():
    try:
        import tomllib  # pylint: disable=import-outside-toplevel
    except ImportError as e:
        raise TsvError("reading Cargo.lock needs Python 3.11 or later (tomllib)") from e
    return tomllib


def read_cargo_files(path):
    """Returns (bytes of <top>/Cargo.lock or None, set of package names the
    tarball's Cargo.toml files declare) of a cargo component tarball that
    passed check_tar. A Cargo.toml that does not parse names nothing."""
    tomllib = load_tomllib()
    lock = None
    local = set()
    with tarfile.open(path, "r:*") as tar:
        for m in tar:
            if not m.isfile():
                continue
            parts = [p for p in m.name.split("/") if p not in ("", ".")]
            if len(parts) == 2 and parts[1] == "Cargo.lock":
                lock = tar.extractfile(m).read()
            elif len(parts) >= 2 and parts[-1] == "Cargo.toml":
                try:
                    doc = tomllib.loads(tar.extractfile(m).read().decode("utf-8"))
                except (UnicodeDecodeError, tomllib.TOMLDecodeError):
                    continue
                pkg = doc.get("package")
                if isinstance(pkg, dict) and isinstance(pkg.get("name"), str):
                    local.add(pkg["name"])
    return lock, local


def lock_crates(comp, data, local):
    """Returns (crates, problems) from the bytes of a Cargo.lock: one dict
    (name, version, sha256) per crates.io package and version, sorted by
    folder name <name>-<version>."""
    tomllib = load_tomllib()
    try:
        doc = tomllib.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
        return [], [f"{comp}: Cargo.lock is not valid TOML: {e}"]
    pkgs = doc.get("package")
    if not isinstance(pkgs, list) or not pkgs:
        return [], [f"{comp}: Cargo.lock lists no packages"]
    seen = {}
    problems = []
    for p in pkgs:
        if not isinstance(p, dict):
            problems.append(f"{comp}: Cargo.lock has a malformed [[package]] entry")
            continue
        n, v, src, ck = p.get("name"), p.get("version"), p.get("source"), p.get("checksum")
        if not (isinstance(n, str) and CRATE_NAME_RE.match(n) and isinstance(v, str) and CRATE_VERSION_RE.match(v)):
            problems.append(f"{comp}: Cargo.lock has a package with an invalid name or version ({n!r} {v!r})")
            continue
        if src is None:
            if n not in local:
                problems.append(
                    f"{comp}: Cargo.lock package {n} {v} has no source, and no Cargo.toml in the tarball "
                    "declares it (a path dependency outside the source); it cannot be vendored"
                )
            continue
        if src != CRATES_IO_SOURCE:
            kind = "git" if str(src).startswith("git+") else "non-crates.io"
            problems.append(
                f"{comp}: Cargo.lock package {n} {v} comes from a {kind} source ({src}); "
                "only crates from the crates.io registry can be vendored"
            )
            continue
        if not (isinstance(ck, str) and SHA_RE.match(ck)):
            problems.append(
                f"{comp}: Cargo.lock package {n} {v} has no SHA-256 checksum field "
                "(lock file format 1 keeps checksums in [metadata], which is not supported)"
            )
            continue
        key = (n, v)
        if key in seen:
            if seen[key] != ck:
                problems.append(f"{comp}: Cargo.lock lists {n} {v} twice with different checksums")
            continue
        seen[key] = ck
    crates = [{"name": n, "version": v, "sha256": ck} for (n, v), ck in seen.items()]
    crates.sort(key=lambda k: f"{k['name']}-{k['version']}")
    return crates, problems


def check_crate(path, folder):
    """Returns None if the .crate file holds only files and folders below
    <folder>/, including <folder>/Cargo.toml, else a reason."""
    has_toml = False
    try:
        with tarfile.open(path, "r:gz") as tar:
            for m in tar:
                name = m.name
                if name.startswith("/") or ".." in name.split("/"):
                    return f"unsafe member path '{name}'"
                parts = [p for p in name.split("/") if p not in ("", ".")]
                if not parts:
                    continue
                if parts[0] != folder:
                    return f"member '{name}' is outside the folder {folder}/"
                if not (m.isfile() or m.isdir()):
                    return f"'{name}' is neither a regular file nor a folder"
                if parts == [folder, "Cargo.toml"] and m.isfile():
                    has_toml = True
    except (tarfile.TarError, OSError, EOFError, zlib.error) as e:
        return f"unreadable crate: {e}"
    if not has_toml:
        return f"no {folder}/Cargo.toml"
    return None


def fetch_crates(comp, path, cdir, base):
    """Downloads and verifies the crates.io crates that the Cargo.lock in
    the component tarball names. Returns (crates, problems, mismatch); each
    crate dict gets 'path', the verified .crate file."""
    try:
        data, local = read_cargo_files(path)
        if data is None:
            return [], [f"{comp}: the tarball has no Cargo.lock in its top folder; a cargo component needs one"], False
        crates, problems = lock_crates(comp, data, local)
    except TsvError as e:
        return [], [f"{comp}: {e}"], False
    except (tarfile.TarError, OSError, EOFError, zlib.error) as e:
        return [], [f"{comp}: cannot read Cargo.lock: {e}"], False
    if problems:
        return [], problems, False
    os.makedirs(cdir, exist_ok=True)
    mismatch = False
    fetched = 0
    for k in crates:
        folder = f"{k['name']}-{k['version']}"
        dest = os.path.join(cdir, folder + ".crate")
        if os.path.exists(dest) and sha256_of(dest) != k["sha256"]:
            log(f"{comp}: cached crate {folder} does not match Cargo.lock; downloading again")
            os.unlink(dest)
        if not os.path.exists(dest):
            url = f"{base}/{k['name']}/{folder}.crate"
            log(f"{comp}: downloading crate {url}")
            try:
                download(url, dest)
            except OSError as e:
                problems.append(f"{comp}: crate {folder}: {e}")
                continue
            fetched += 1
            digest = sha256_of(dest)
            if digest != k["sha256"]:
                os.unlink(dest)
                mismatch = True
                problems.append(
                    f"{comp}: crate {folder}: sha256 {digest} does not match Cargo.lock's {k['sha256']}; download deleted"
                )
                continue
        reason = check_crate(dest, folder)
        if reason:
            problems.append(f"{comp}: crate {folder}: {reason}")
            continue
        k["path"] = dest
    if not problems:
        log(f"{comp}: {len(crates)} crates of Cargo.lock verified ({fetched} downloaded, {len(crates) - fetched} cached)")
    return crates, problems, mismatch


def checksum_json(sha):
    return json.dumps({"files": {}, "package": sha}, sort_keys=True, separators=(",", ":")).encode("utf-8")


def tar_entry(name, mode, size=None):
    info = tarfile.TarInfo(name)
    info.mode = mode
    info.mtime = 0
    info.uid = info.gid = 0
    info.uname = info.gname = ""
    if size is None:
        info.type = tarfile.DIRTYPE
    else:
        info.type = tarfile.REGTYPE
        info.size = size
    return info


def write_tgz(dest, fill):
    """Writes the reproducible tarball <dest>: fill(out) adds the members to
    the tar writer <out> (with tar_entry: mtime 0, owner and group 0 with
    empty names) in path order; the gzip header has mtime 0 and no file
    name. The tarball is written as <dest>.tmp and renamed, so a failure
    leaves no partial file."""
    tmp = dest + ".tmp"
    try:
        with open(tmp, "wb") as raw:
            with gzip.GzipFile(filename="", mode="wb", fileobj=raw, compresslevel=9, mtime=0) as gz:
                with tarfile.open(fileobj=gz, mode="w", format=tarfile.GNU_FORMAT) as out:
                    fill(out)
        os.replace(tmp, dest)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


def add_tree(out, prefix, files):
    """Adds the folder <prefix> (a tuple of path parts) to the tar writer
    <out>, and below it <files> ({path tuple below prefix: (mode, bytes)})
    with every folder between them; folders get mode 0755. Members are
    sorted by path."""
    dirs = {()}
    for rel in files:
        for i in range(1, len(rel)):
            dirs.add(rel[:i])
    items = [(d, None) for d in dirs] + list(files.items())
    items.sort(key=lambda item: item[0])
    for rel, val in items:
        name = "/".join(prefix + rel)
        if val is None:
            out.addfile(tar_entry(name, 0o755))
        else:
            out.addfile(tar_entry(name, val[0], len(val[1])), io.BytesIO(val[1]))


def pack_crates(dest, top, crates):
    """Writes the reproducible crates tarball <dest> (top folder <top>/)."""

    def fill(out):
        out.addfile(tar_entry(top, 0o755))
        for k in crates:
            folder = f"{k['name']}-{k['version']}"
            files = {}
            with tarfile.open(k["path"], "r:gz") as tar:
                for m in tar:
                    if not m.isfile():
                        continue
                    rel = tuple(p for p in m.name.split("/") if p not in ("", "."))[1:]
                    if not rel or rel == (".cargo-checksum.json",):
                        continue
                    files[rel] = (m.mode & 0o777, tar.extractfile(m).read())
            files[(".cargo-checksum.json",)] = (0o644, checksum_json(k["sha256"]))
            add_tree(out, (top, folder), files)

    write_tgz(dest, fill)


def pack_file(dest, top, name, path):
    """Writes the reproducible tarball <dest> of a file component: the top
    folder <top>/ with the file <path> as <top>/<name>, mode 0644."""
    with open(path, "rb") as f:
        data = f.read()
    write_tgz(dest, lambda out: add_tree(out, (top,), {(name,): (0o644, data)}))


def read_version():
    try:
        with open(VERSION_FILE, encoding="utf-8") as f:
            v = f.readline().strip()
    except OSError as e:
        raise TsvError(f"cannot read {VERSION_FILE}: {e}") from e
    return v


def rewrite_tsv(path, lines, updates):
    for idx, digest in updates.items():
        parts = lines[idx].split("\t")
        parts[3] = digest
        lines[idx] = "\t".join(parts)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    os.replace(tmp, path)


def layout(out, source, version, comps, files):
    orig = os.path.join(out, "orig")
    os.makedirs(orig, exist_ok=True)
    prefix = f"{source}_"
    for n in os.listdir(orig):
        if n.startswith(prefix) and ".orig-" in n:
            os.unlink(os.path.join(orig, n))
    for c in comps:
        if c["build"] in FILE_BUILDS:
            continue  # packed by main() after the layout
        dest = os.path.join(orig, f"{source}_{version}.orig-{c['name']}.tar.{c['ext']}")
        try:
            os.link(files[c["name"]], dest)
        except OSError:
            shutil.copy2(files[c["name"]], dest)
    return orig


def main(argv=None):
    p = argparse.ArgumentParser(prog="fetch-sources", description="Download and verify the sources of a Motanka source package.")
    p.add_argument("--components", "--tsv", dest="tsv", default=TSV)
    p.add_argument("--out", default=DEFAULT_OUT)
    p.add_argument("--update-checksums", action="store_true")
    p.add_argument("--version")
    p.add_argument("--check", action="store_true")
    args = p.parse_args(argv)
    tsv = os.path.abspath(args.tsv)

    if os.geteuid() == 0:
        log("refusing to run as root")
        return EXIT_USAGE
    try:
        lines, comps, meta = parse_tsv(tsv)
        version = args.version or read_version()
    except (TsvError, OSError) as e:
        log(str(e))
        return EXIT_USAGE
    if not VERSION_RE.match(version) or "-" in version:
        log(f"invalid Motanka version '{version}'")
        return EXIT_USAGE
    source = meta["source"]
    if args.check:
        log(f"{tsv}: {len(comps)} components, valid (source {source})")
        return 0

    base = None
    if any(c["build"] in CARGO_BUILDS for c in comps):
        try:
            base = crates_base_url()
        except TsvError as e:
            log(str(e))
            return EXIT_USAGE

    out = os.path.abspath(args.out)
    dl = os.path.join(out, "downloads")
    os.makedirs(dl, exist_ok=True)

    problems = []
    mismatch = False
    updates = {}
    files = {}
    crates_of = {}
    for c in comps:
        name, pinned = c["name"], c["sha256"]
        if c["build"] in FILE_BUILDS:
            path = os.path.join(dl, f"{name}-{c['version']}.{c['file']}")
        else:
            path = os.path.join(dl, f"{name}-{c['version']}.tar.{c['ext']}")
        if os.path.exists(path) and pinned != "-" and sha256_of(path) != pinned:
            log(f"{name}: cached file does not match the pinned checksum; downloading again")
            os.unlink(path)
        if os.path.exists(path):
            log(f"{name} {c['version']}: cached")
        else:
            log(f"{name} {c['version']}: downloading {c['url']}")
            try:
                download(c["url"], path)
            except OSError as e:
                problems.append(f"{name}: {e}")
                continue
        digest = sha256_of(path)
        if pinned == "-":
            if args.update_checksums:
                updates[c["line"]] = digest
                log(f"{name}: pinning sha256 {digest}")
            else:
                problems.append(f"{name}: no sha256 pinned (computed {digest}); review it and run with --update-checksums")
                continue
        elif digest != pinned:
            os.unlink(path)
            mismatch = True
            problems.append(f"{name}: sha256 {digest} does not match the pinned {pinned}; download deleted")
            continue
        if c["build"] in FILE_BUILDS:
            if os.path.getsize(path) == 0:
                problems.append(f"{name}: the downloaded file {c['file']} is empty")
                continue
            files[name] = path
            continue
        reason = check_tar(path, c["build"] in FLAT_OK_BUILDS)
        if reason:
            problems.append(f"{name}: {reason}")
            continue
        if c["build"] in CARGO_BUILDS:
            crates, cprobs, cmis = fetch_crates(name, path, os.path.join(dl, "crates"), base)
            if cprobs:
                problems.extend(cprobs)
                mismatch = mismatch or cmis
                continue
            crates_of[name] = crates
        files[name] = path

    if updates:
        rewrite_tsv(tsv, lines, updates)
        log(f"wrote {len(updates)} checksum(s) into {tsv}")
    if problems:
        for msg in problems:
            log(f"error: {msg}")
        return EXIT_MISMATCH if mismatch else EXIT_PROBLEM

    orig = layout(out, source, version, comps, files)
    for c in comps:
        if c["build"] not in FILE_BUILDS:
            continue
        dest = os.path.join(orig, f"{source}_{version}.orig-{c['name']}.tar.gz")
        try:
            pack_file(dest, c["name"], c["file"], files[c["name"]])
        except (OSError, tarfile.TarError) as e:
            log(f"error: {c['name']}: cannot write {dest}: {e}")
            return EXIT_PROBLEM
        log(f"{c['name']}: {c['file']} packed into {os.path.basename(dest)}")
    for c in comps:
        if c["build"] not in CARGO_BUILDS:
            continue
        top = c["name"] + CRATES_SUFFIX
        dest = os.path.join(orig, f"{source}_{version}.orig-{top}.tar.gz")
        try:
            pack_crates(dest, top, crates_of[c["name"]])
        except (OSError, tarfile.TarError, EOFError, zlib.error) as e:
            log(f"error: {c['name']}: cannot write {dest}: {e}")
            return EXIT_PROBLEM
        log(f"{c['name']}: {len(crates_of[c['name']])} crates packed into {os.path.basename(dest)}")
    extra = f" plus {len(crates_of)} crates component(s)" if crates_of else ""
    log(f"{len(comps)} components of {source} verified{extra}; orig tarballs in {orig}")
    print(orig)
    return 0


if __name__ == "__main__":
    sys.exit(main())
