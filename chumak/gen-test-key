#!/usr/bin/env bash
# Create the development (TEST) signing key of the Motanka repository.
#
# Usage: chumak/gen-test-key [--force] [--vm <name>]
#
# The key is an Ed25519 OpenPGP key without a passphrase, generated with gpg
# inside a throwaway resolute VM (the host has gpgv only). Results:
#   ~/.cache/motanka-vm/keys/motanka-test-archive.sec.asc  secret key (0600)
#   ~/.cache/motanka-vm/keys/motanka-test-archive.pub.asc  public key
#   ~/.cache/motanka-vm/keys/fingerprint                   fingerprint
#   packaging/keys/motanka-archive.asc                     public key with a
#                                                          header marking it
#                                                          as a TEST key
# The secret key never enters the repository. If the key already exists,
# only packaging/keys/motanka-archive.asc is rewritten from it and no VM is
# booted; --force generates a new key. Real releases replace
# packaging/keys/motanka-archive.asc with the public half of the offline
# release key.
#
#   --vm   use a running VM instead of booting one; it is not torn down
set -euo pipefail
# shellcheck source=../test/vm/lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../test/vm/lib.sh"
MV_USAGE="chumak/gen-test-key [--force] [--vm <name>]"
mv_init

force=false
vm=""
while (($# > 0)); do
  case $1 in
    --force)
      force=true
      shift
      ;;
    --vm)
      if (($# < 2)); then
        mv_usage "--vm needs a value"
      fi
      vm=$2
      shift 2
      ;;
    -h | --help)
      printf 'usage: %s\n' "$MV_USAGE"
      exit 0
      ;;
    *) mv_usage "unknown argument '$1'" ;;
  esac
done

SEC=$MV_KEYS/motanka-test-archive.sec.asc
PUB=$MV_KEYS/motanka-test-archive.pub.asc
FPR=$MV_KEYS/fingerprint
REPO_KEY=$MV_REPO/packaging/keys/motanka-archive.asc

# Runs in the VM as tester; writes a tar of sec.asc, pub.asc and fingerprint
# to stdout and everything else to stderr.
# shellcheck disable=SC2016 # expanded in the VM
REMOTE='set -euo pipefail
virt=$(systemd-detect-virt 2>/dev/null || true)
if [[ -z $virt || $virt == none ]]; then
  echo "gen-test-key: refusing to run outside a VM" >&2
  exit 1
fi
if ! command -v gpg >/dev/null || ! command -v gpg-agent >/dev/null; then
  sudo apt-get -q -o DPkg::Lock::Timeout=300 update >&2
  sudo DEBIAN_FRONTEND=noninteractive apt-get -q -y -o DPkg::Lock::Timeout=300 \
    install --no-install-recommends gpg gpg-agent >&2
fi
GNUPGHOME=$(mktemp -d)
export GNUPGHOME
out=$(mktemp -d)
trap "gpgconf --kill all >/dev/null 2>&1 || true; rm -rf \"$GNUPGHOME\" \"$out\"" EXIT
gpg --batch --pinentry-mode loopback --passphrase "" --quick-generate-key \
  "Motanka TEST archive key (development only, not for releases)" \
  ed25519 sign never >&2
fpr=$(gpg --batch --with-colons --list-secret-keys | awk -F: "\$1 == \"fpr\" { print \$10; exit }")
gpg --batch --pinentry-mode loopback --passphrase "" --armor \
  --export-secret-keys "$fpr" >"$out/sec.asc"
gpg --batch --armor --comment "TEST KEY - development builds only, not for releases" \
  --export "$fpr" >"$out/pub.asc"
printf "%s\n" "$fpr" >"$out/fingerprint"
tar -C "$out" -cf - .'

write_repo_key() {
  local fpr tmp
  fpr=$(<"$FPR")
  if [[ ! -d $(dirname "$REPO_KEY") ]]; then
    mkdir -p "$(dirname "$REPO_KEY")"
    chmod 0755 "$(dirname "$REPO_KEY")"
  fi
  tmp=$(mktemp "$(dirname "$REPO_KEY")/.motanka-archive.asc.XXXXXX")
  {
    printf '# TEST KEY. Generated by chumak/gen-test-key for development builds only.\n'
    printf '# Its secret half stays outside the repository, in ~/.cache/motanka-vm/keys/\n'
    printf '# of the machine that generated it. Real releases replace this file with\n'
    printf '# the public half of the Motanka archive key.\n'
    printf '# Fingerprint: %s\n' "$fpr"
    cat "$PUB"
  } >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$REPO_KEY"
  mv_log "wrote $REPO_KEY (TEST key $fpr)"
}

if ! $force && [[ -s $SEC && -s $PUB && -s $FPR ]]; then
  mv_log "using the existing TEST key in $MV_KEYS (--force makes a new one)"
  write_repo_key
  exit 0
fi

if [[ -n $vm ]]; then
  mv_require_running "$vm"
else
  mv_check_kvm
  mv_need qemu-system-x86_64 qemu-img ssh ssh-keygen python3 setsid timeout
  vm=$("$MV_LIB_DIR/up" resolute fresh </dev/null | tail -n 1)
  if ! mv_valid_name "$vm"; then
    mv_die "test/vm/up printed an invalid VM name '$vm'"
  fi
  MV_CLEANUP_VMS+=("$vm")
fi

mkdir -p "$MV_STATE"
tmp=$(mktemp -d "$MV_STATE/.keys.XXXXXX")
MV_CLEANUP_PATHS+=("$tmp")
mv_log "generating an Ed25519 TEST key in $vm"
"$MV_LIB_DIR/run" "$vm" -- bash -c "$REMOTE" </dev/null |
  tar -C "$tmp" --no-same-owner -xf -

fpr=$(tr -d '[:space:]' <"$tmp/fingerprint" 2>/dev/null || true)
if [[ ! $fpr =~ ^[0-9A-F]{40}$ ]]; then
  mv_die "the VM returned no valid fingerprint"
fi
if ! grep -q '^-----BEGIN PGP PRIVATE KEY BLOCK-----$' "$tmp/sec.asc" ||
  ! grep -q '^-----BEGIN PGP PUBLIC KEY BLOCK-----$' "$tmp/pub.asc"; then
  mv_die "the VM did not return an armored key pair"
fi

mkdir -p "$MV_KEYS"
chmod 0700 "$MV_KEYS"
chmod 0600 "$tmp/sec.asc"
chmod 0644 "$tmp/pub.asc" "$tmp/fingerprint"
mv -f "$tmp/sec.asc" "$SEC"
mv -f "$tmp/pub.asc" "$PUB"
mv -f "$tmp/fingerprint" "$FPR"
mv_log "stored the TEST key $fpr in $MV_KEYS"
write_repo_key
