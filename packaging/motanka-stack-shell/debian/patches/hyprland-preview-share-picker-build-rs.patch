Description: set the version without asking git
 build.rs runs "git describe" and "git log" to set GIT_VERSION, which
 --version prints. The source package is not a git repository: with git
 installed build.rs panics slicing an empty string, and the build fails.
 This is the build.rs of Upstream's PKGBUILD, which sets the version of
 the pinned commit 07602ef (pkgver 0.3.0.r3.g07602ef) in git describe
 form.
Origin: https://github.com/omacom/omarchy-pkgs/blob/master/pkgbuilds/hyprland-preview-share-picker/PKGBUILD
Author: Motanka
Forwarded: not-needed
---
--- a/hyprland-preview-share-picker/build.rs
+++ b/hyprland-preview-share-picker/build.rs
@@ -1,30 +1,3 @@
 fn main() {
-    let version =
-        match std::process::Command::new("git").arg("describe").arg("--long").arg("--abbrev=7").arg("--tags").output() {
-            Ok(output) => {
-                let str = String::from_utf8_lossy(&output.stdout);
-                let split = str.trim().split('-').collect::<Vec<_>>();
-                format!("{}-r{}-{}", &split[0][1..], split[1], split[2])
-            }
-            Err(err) => {
-                println!("cargo::warning=Unable to get git version: {err:#}");
-                String::from("unknown")
-            }
-        };
-
-    let commit = match std::process::Command::new("git").arg("log").arg("--format=[%s]").arg("-n").arg("1").output() {
-        Ok(output) => {
-            if output.stdout.is_empty() {
-                String::from("unknown")
-            } else {
-                String::from_utf8_lossy(&output.stdout).trim().to_string()
-            }
-        }
-        Err(err) => {
-            println!("cargo::warning=Unable to get latest git commit: {err:#}");
-            String::from("unknown")
-        }
-    };
-
-    println!("cargo::rustc-env=GIT_VERSION={version} {commit}");
+    println!("cargo::rustc-env=GIT_VERSION=v0.3.0-r3-g07602ef");
 }
