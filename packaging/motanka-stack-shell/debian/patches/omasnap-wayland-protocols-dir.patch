Description: take the wayland-protocols folder from a cache variable
 omasnap names /usr/share/wayland-protocols for the ext-foreign-toplevel-list,
 ext-image-capture-source and ext-image-copy-capture XML files. Ubuntu
 24.04's wayland-protocols (1.34) has neither ext-image protocol, so the
 Motanka build points OMASNAP_WAYLAND_PROTOCOLS_DIR at the staged
 wayland-protocols 1.50 on both releases. The default keeps the old path.
Author: Motanka
Forwarded: no
---
--- a/omasnap/CMakeLists.txt
+++ b/omasnap/CMakeLists.txt
@@ -35,11 +35,14 @@
 pkg_check_modules(Libdeflate REQUIRED IMPORTED_TARGET libdeflate)
 find_program(WAYLAND_SCANNER wayland-scanner REQUIRED)
 
+set(OMASNAP_WAYLAND_PROTOCOLS_DIR /usr/share/wayland-protocols CACHE PATH
+  "Folder that holds the wayland-protocols XML files")
+
 set(PROTOCOL_XMLS
   # ext-image-capture-source references this interface even for output-only use.
-  /usr/share/wayland-protocols/staging/ext-foreign-toplevel-list/ext-foreign-toplevel-list-v1.xml
-  /usr/share/wayland-protocols/staging/ext-image-capture-source/ext-image-capture-source-v1.xml
-  /usr/share/wayland-protocols/staging/ext-image-copy-capture/ext-image-copy-capture-v1.xml
+  ${OMASNAP_WAYLAND_PROTOCOLS_DIR}/staging/ext-foreign-toplevel-list/ext-foreign-toplevel-list-v1.xml
+  ${OMASNAP_WAYLAND_PROTOCOLS_DIR}/staging/ext-image-capture-source/ext-image-capture-source-v1.xml
+  ${OMASNAP_WAYLAND_PROTOCOLS_DIR}/staging/ext-image-copy-capture/ext-image-copy-capture-v1.xml
   ${CMAKE_CURRENT_SOURCE_DIR}/protocols/wlr-virtual-pointer-unstable-v1.xml
 )
 set(PROTOCOL_SOURCES)
