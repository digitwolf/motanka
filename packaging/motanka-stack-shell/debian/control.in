               gcc-16,
               g++-16,
               cmake,
               meson,
               ninja-build,
               pkgconf,
               binutils,
               libcli11-dev,
               libdrm-dev,
               libegl-dev,
               libgbm-dev,
               libgl-dev,
               libglib2.0-dev,
               libglvnd-dev,
               libjemalloc-dev,
               libpam0g-dev,
               libpipewire-0.3-dev,
               libpolkit-agent-1-dev,
               libpolkit-gobject-1-dev,
               libunwind-dev,
               libwayland-dev,
               libxcb1-dev,
               libzstd-dev,
