#!/usr/bin/make -f
# Builds the components of stack/shell-components.tsv (cpptrace, Quickshell,
# layer-shell-qt, omasnap, ttfx and, on resolute,
# hyprland-preview-share-picker, with wayland-protocols, libdwarf-lite,
# extra-cmake-modules, on noble wayland and CMake, and on resolute
# hyprland-protocols at build time; the cargo components offline from the
# crates of their <name>-crates components) for
# the suite in the changelog (noble or resolute, stamped by
# packaging/build.sh) with prefix /opt/motanka, into motanka-stack-shell.
# The work is done by debian/shell-build.sh; see the comment at its top.

# LTO is off, as in motanka-stack and motanka-qt6.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto

DIST := $(shell dpkg-parsechangelog -SDistribution)
VERSION := $(shell dpkg-parsechangelog -SVersion)
STAGE_LIB := $(CURDIR)/debian/shell-build/stage/opt/motanka/lib

%:
	dh $@

# The share picker's build replaces the empty git-submodule folder
# lib/hyprland-protocols with a symbolic link to hyprland-protocols/;
# clean puts the empty folder of the orig tarball back.
SHARE_PICKER_PROTOCOLS := hyprland-preview-share-picker/lib/hyprland-protocols

override_dh_auto_clean:
	rm -rf debian/shell-build debian/shlibs.local
	if [ -L $(SHARE_PICKER_PROTOCOLS) ]; then \
		rm -f $(SHARE_PICKER_PROTOCOLS) && mkdir $(SHARE_PICKER_PROTOCOLS); \
	fi

override_dh_auto_configure:

override_dh_auto_build:
	bash debian/shell-build.sh build $(DIST)

# --version of the cargo components, then omasnap's smoke suite, offscreen (Upstream's
# PKGBUILD check()).
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	bash debian/shell-build.sh test $(DIST)
endif

override_dh_auto_install:
	bash debian/shell-build.sh install $(DIST)

override_dh_dwz:

# Libraries in /opt/motanka/lib are outside the ldconfig path: no ldconfig
# trigger, no shipped shlibs file. debian/shlibs.local covers libcpptrace,
# libLayerShellQtInterface, the libraries of motanka-qt6 (exact version: Qt
# private API) and, on noble, those of motanka-stack-libs.
override_dh_makeshlibs:
	bash debian/shell-build.sh shlibs $(DIST) $(VERSION)

# -x: no self-dependency for libcpptrace and libLayerShellQtInterface. -S:
# look in this package's tree first. -l: the staging folder, so a staged but
# unshipped library fails with "no dependency information".
override_dh_shlibdeps:
	dh_shlibdeps -- -xmotanka-stack-shell \
		-Sdebian/motanka-stack-shell -l$(STAGE_LIB)
