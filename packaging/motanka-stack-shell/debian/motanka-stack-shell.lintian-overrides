# The Stack lives in /opt/motanka by design (DESIGN.md, "Linux practices"),
# so it never shadows a host package.
dir-or-file-in-opt
# Quickshell, omasnap and layer-shell-qt's plugins find libcpptrace,
# libLayerShellQtInterface and the Stack's Qt (and, on 24.04, GCC 16's C++
# runtime) through RUNPATH /opt/motanka/lib instead of ld.so.conf.d or
# LD_LIBRARY_PATH, which would leak into programs outside the Stack.
custom-library-search-path
# libcpptrace and libLayerShellQtInterface are private libraries of the
# shell and of omasnap, not library packages.
package-name-doesnt-match-sonames
# The share picker's serde_yaml uses unsafe-libyaml, a Rust translation of
# libyaml compiled in with the rest of the crates (no copy of the C library);
# Debian's own Rust packages override this tag for the same reason.
embedded-library libyaml [opt/motanka/bin/hyprland-preview-share-picker]
