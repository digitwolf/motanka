# Locally built Motanka .debs that sbuild gets with --extra-package, at
# build time only (packaging/build.sh). Format: <suite> <binary package>...
# Each must be <name>_<version>_amd64.deb of the version being built.
# noble: Qt 6.10 (motanka-qt6-dev pulls motanka-qt6), and motanka-stack-libs,
# which motanka-qt6 depends on for GCC 16's C++ runtime.
noble motanka-qt6 motanka-qt6-dev motanka-stack-libs
