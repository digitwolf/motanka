# The Stack lives in /opt/motanka by design (DESIGN.md, "Linux practices"),
# so it never shadows a host package.
dir-or-file-in-opt
# Stack binaries find their libraries through RUNPATH /opt/motanka/lib
# instead of ld.so.conf.d or LD_LIBRARY_PATH, which would leak into
# programs outside the Stack.
custom-library-search-path
# One package carries all private libraries of the Stack.
package-name-doesnt-match-sonames
