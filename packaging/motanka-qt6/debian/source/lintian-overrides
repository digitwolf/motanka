# The orig-<component> tarballs are Qt's release tarballs, used unmodified
# and pinned by SHA-256 in stack/qt6-components.tsv. Their test data,
# examples, documentation sources and bundled third-party trees (among
# them qtimageformats' copies of libwebp, libtiff, libmng and jasper) are
# not rebuilt from source because nothing from them is built or shipped
# (tests and examples are off; the image plugins use the archive's
# libraries, or on noble Qt's libwebp copy if 24.04's is not accepted).
source-is-missing
source-contains-prebuilt-binary
source-contains-prebuilt-windows-binary
source-contains-prebuilt-javascript-object
source-contains-prebuilt-wasm-binary
source-contains-prebuilt-java-object
source-contains-prebuilt-ms-help-file
source-contains-prebuilt-doxygen-documentation
source-contains-prebuilt-sphinx-documentation
source-contains-autogenerated-visual-c++-file
very-long-line-length-in-source-file
# Qt's network tests quote RFC text as fixtures.
license-problem-non-free-RFC
license-problem-non-free-RFC-BCP78
# qtbase's plugin-loader tests carry deliberately broken ELF objects.
binary-with-bad-dynamic-table [qtbase/tests/*]
