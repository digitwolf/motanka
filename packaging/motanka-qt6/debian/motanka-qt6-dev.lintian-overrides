# Build files of the Qt in /opt/motanka (DESIGN.md, "Linux practices").
dir-or-file-in-opt
# Qt's tools find their libraries through RUNPATH /opt/motanka/lib.
custom-library-search-path
# Qt installs its SBOM generator without the executable bit; it is only read
# by Qt's CMake files, never run from the package.
executable-not-elf-or-script [opt/motanka/lib/qt6/libexec/qt_cyclonedx_generator.py]
# The field marks the package as build-only so chumak/build-repo leaves it
# out of the published repository (packaging/motanka-qt6/README).
unknown-field Motanka-Build-Only
