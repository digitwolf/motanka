#!/bin/bash
# omarchy-pkg-defaults: Motanka override of Upstream bin/omarchy-pkg-defaults.
#
# usage (as Upstream): omarchy-pkg-defaults [x86|aarch64|aarch64-apple|...]
#
# Prints the default package set, one Arch name per line, first occurrence
# kept, as Upstream does for x86: the names in
# $OMARCHY_PATH/install/omarchy-base.packages. Motanka runs on amd64 only,
# so without an argument the platform is x86 (Upstream asks
# omarchy-hw-platform), and the aarch64 platforms are refused with exit 1.
# The names are Arch names; omarchy-pkg-add maps them.
set -euo pipefail

platform=${1:-x86}

# Image builders written before the platform names settled pass the old ones.
case $platform in
  generic) platform=x86 ;;
  apple-silicon) platform=aarch64-apple ;;
  generic-aarch64) platform=aarch64 ;;
  qualcomm) platform=aarch64-qualcomm ;;
esac

case $platform in
  x86) ;;
  aarch64 | aarch64-apple | aarch64-qualcomm | aarch64-n1x | aarch64-gb10)
    echo "Error: Motanka runs on x86 (amd64) only, not on '$platform'" >&2
    exit 1
    ;;
  *)
    echo "Error: unknown platform '$platform'" >&2
    exit 1
    ;;
esac

file=${OMARCHY_PATH:-/usr/share/omarchy}/install/omarchy-base.packages
sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$file" | awk '!seen[$0]++'
