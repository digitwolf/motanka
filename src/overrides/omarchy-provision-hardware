#!/bin/bash
# omarchy-provision-hardware: Motanka override of Upstream
# bin/omarchy-provision-hardware: unsupported (compat/overrides.tsv). Prints
# why, writes a journal entry and exits 64.
set -euo pipefail
_self=$(readlink -f -- "${BASH_SOURCE[0]}")
_base=${_self%/*/*}
MK_CMD=override
# shellcheck source=../lib/common.sh
source "$_base/lib/common.sh"
# shellcheck source=../lib/outcomes.sh
source "$_base/lib/outcomes.sh"
mk_oc_unsupported omarchy-provision-hardware \
  "it is a step of Upstream's Arch installer (pacman keyring, mkinitcpio and Limine setup); Motanka's packages replace the installer" "$@"
