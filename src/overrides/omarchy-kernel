#!/bin/bash
# omarchy-kernel: Motanka override of Upstream bin/omarchy-kernel: unsupported
# (compat/overrides.tsv). Prints why, writes a journal entry and exits 64.
set -euo pipefail
_self=$(readlink -f -- "${BASH_SOURCE[0]}")
_base=${_self%/*/*}
MK_CMD=override
# shellcheck source=../lib/common.sh
source "$_base/lib/common.sh"
# shellcheck source=../lib/outcomes.sh
source "$_base/lib/outcomes.sh"
mk_oc_unsupported omarchy-kernel \
  "it chooses the kernel Limine boots; the host's bootloader and kernels stay as they are" "$@"
