#!/bin/bash
# omarchy-upgrade-to-quattro: Motanka override of Upstream
# bin/omarchy-upgrade-to-quattro: unsupported (compat/overrides.tsv). Prints
# why, writes a journal entry and exits 64.
set -euo pipefail
_self=$(readlink -f -- "${BASH_SOURCE[0]}")
_base=${_self%/*/*}
MK_CMD=override
# shellcheck source=../lib/common.sh
source "$_base/lib/common.sh"
# shellcheck source=../lib/outcomes.sh
source "$_base/lib/outcomes.sh"
mk_oc_unsupported omarchy-upgrade-to-quattro \
  "it migrates an Arch installation to a new Upstream major version; Motanka moves to new Upstream versions with 'sudo motanka update'" "$@"
