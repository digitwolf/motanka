#!/bin/bash
# omarchy-sudo-passwordless: Motanka override of Upstream
# bin/omarchy-sudo-passwordless: unsupported (compat/overrides.tsv).
#
# usage (as Upstream): omarchy-sudo-passwordless [MINUTES|permanent|--active|--disable]
#
# Upstream grants passwordless sudo with sudoers files, tmpfiles entries and
# a pacman hook. Motanka ships no sudoers files and never grants it, so:
#   --active   passwordless sudo is not active: exit 1, silently
#   --disable  it is already disabled: message, exit 0
#   otherwise  not available: message, journal entry, exit 64
set -euo pipefail

case ${1:-} in
  --active)
    exit 1
    ;;
  --disable)
    echo "Passwordless sudo is already DISABLED."
    exit 0
    ;;
esac

_self=$(readlink -f -- "${BASH_SOURCE[0]}")
_base=${_self%/*/*}
MK_CMD=override
# shellcheck source=../lib/common.sh
source "$_base/lib/common.sh"
# shellcheck source=../lib/outcomes.sh
source "$_base/lib/outcomes.sh"
mk_oc_unsupported omarchy-sudo-passwordless \
  "it writes sudoers files, which Motanka never ships; Motanka asks for authorisation through polkit for each package operation" "$@"
