#!/bin/bash
# bat: Ubuntu's bat package installs the command as batcat; Upstream calls
# bat. This runs batcat. It is on PATH only inside the Wrapper scope
# (run-upstream), so nothing outside Upstream's commands sees it.
set -euo pipefail
if ! command -v batcat >/dev/null 2>&1; then
  printf 'bat: batcat is not installed (Ubuntu package bat)\n' >&2
  exit 127
fi
exec batcat "$@"
