#!/usr/bin/env python3
r"""Make a roff man page from its Markdown source (task 24.5).

usage: tools/mkman SOURCE [-o FILE | --check FILE]

SOURCE is a man page written in the subset of pandoc's Markdown below. The
roff (man(7)) output goes to stdout, or to FILE through a temporary file and
a rename. --check compares FILE with the output, prints a unified diff and
exits 1 when they differ.

docs/motanka.1 is made this way from docs/motanka.1.md and committed, so the
motanka-core build needs no pandoc; test/unit/manpage.bats fails when it is
not current. Regenerate it with:

  python3 tools/mkman docs/motanka.1.md -o docs/motanka.1

The subset (anything else is an error):

  % NAME(SECTION) FOOTER | HEADER   lines 1 to 3: pandoc's title block;
  % AUTHORS                         the authors line is ignored, the date
  % YYYY-MM-DD                      is YYYY-MM-DD; line 4 is empty
  # HEADING                         .SH HEADING
  ## HEADING                        .SS HEADING
  text lines                        a paragraph: .PP, then each line
  TERM                              a definition: .TP, the term, then the
  :   DEFINITION                    definition, whose further lines are
      MORE DEFINITION               indented by 4 spaces
  - ITEM                            a bullet item: .IP \(bu 2, then the
    MORE ITEM                       item, whose further lines are indented
                                    by 2 spaces
  ```                               a literal block (.nf), unformatted
  literal lines
  ```

A blank line ends a paragraph, a definition or an item. Inline, `code` and
**text** are set in bold and *text* in italics; code spans are taken
literally. Lines keep their breaks (roff fills them). Every '-' becomes
'\-', which man prints as an ASCII hyphen-minus, so options can be copied;
'\' becomes '\e'; a line that would start with '.' or "'" gets '\&' in
front. A tab, an indented line outside a definition or item, a stray '*'
and an unclosed '`' are errors.

Exit codes: 0 done, 1 --check found differences, 2 usage or input error.
Python 3 standard library only.
"""

import argparse
import difflib
import os
import re
import sys
import tempfile

TITLE_RE = re.compile(r"^% ([A-Z0-9][A-Z0-9._-]*)\(([1-9])\) (\S.*?) \| (\S.*)$")
DATE_RE = re.compile(r"^% ([0-9]{4}-[0-9]{2}-[0-9]{2})$")
BOLD_RE = re.compile(r"\*\*([^*]+)\*\*")
ITALIC_RE = re.compile(r"\*([^*]+)\*")
FENCE = "```"


class SourceError(Exception):
    pass


def esc(text):
    """Text with roff's escape character and hyphens escaped."""
    return text.replace("\\", "\\e").replace("-", "\\-")


def guard(line):
    """A roff text line that cannot be read as a request."""
    if line.startswith((".", "'")):
        return "\\&" + line
    return line


def inline(text, where):
    """One text line with its inline markup turned into font changes."""
    if text[:1] == " ":
        raise SourceError(f"{where}: unexpected indentation")
    if text == "":
        raise SourceError(f"{where}: empty line where text was expected")
    parts = text.split("`")
    if len(parts) % 2 == 0:
        raise SourceError(f"{where}: unclosed '`'")
    out = []
    for i, part in enumerate(parts):
        if i % 2:
            if part == "":
                raise SourceError(f"{where}: empty code span")
            out.append("\\fB" + esc(part) + "\\fR")
            continue
        s = BOLD_RE.sub(r"\\fB\1\\fR", esc(part))
        s = ITALIC_RE.sub(r"\\fI\1\\fR", s)
        if "*" in s:
            raise SourceError(f"{where}: stray '*' (put it in a code span)")
        out.append(s)
    return guard("".join(out))


def convert(text, name):
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    if len(lines) < 4:
        raise SourceError(f"{name}: too short for a title block and a body")
    m = TITLE_RE.match(lines[0])
    if not m:
        raise SourceError(f"{name}:1: expected '% NAME(SECTION) FOOTER | HEADER'")
    if not lines[1].startswith("%"):
        raise SourceError(f"{name}:2: expected the authors line ('%' and the authors, or '%' alone)")
    d = DATE_RE.match(lines[2])
    if not d:
        raise SourceError(f"{name}:3: expected '% YYYY-MM-DD'")
    if lines[3] != "":
        raise SourceError(f"{name}:4: expected an empty line after the title block")

    out = [f'.\\" Generated by tools/mkman from {name}; do not edit.']
    fields = (m.group(1), m.group(2), d.group(1), m.group(3), m.group(4))
    out.append(".TH " + " ".join(f'"{esc(f)}"' for f in fields))

    body = lines[4:]
    state = None
    in_code = False
    for idx, raw in enumerate(body):
        where = f"{name}:{idx + 5}"
        if "\t" in raw:
            raise SourceError(f"{where}: tab character")
        line = raw.rstrip(" ")
        if in_code:
            if line == FENCE:
                out += [".fi", ".RE"]
                in_code = False
            else:
                out.append(guard(esc(line)))
            continue
        if line == FENCE:
            out += [".PP", ".RS 4", ".nf"]
            in_code = True
            state = None
            continue
        if line == "":
            state = None
            continue
        nxt = body[idx + 1].rstrip(" ") if idx + 1 < len(body) else ""
        if line.startswith("# "):
            out.append(".SH " + esc(line[2:].strip()))
            state = None
        elif line.startswith("## "):
            out.append(".SS " + esc(line[3:].strip()))
            state = None
        elif line.startswith("#"):
            raise SourceError(f"{where}: only '# ' and '## ' headings are supported")
        elif line.startswith(":   "):
            if state != "term":
                raise SourceError(f"{where}: a definition needs its term on the line before")
            out.append(inline(line[4:], where))
            state = "definition"
        elif state == "definition" and line.startswith("    "):
            out.append(inline(line[4:], where))
        elif state == "item" and line.startswith("  "):
            out.append(inline(line[2:], where))
        elif line.startswith(" "):
            raise SourceError(f"{where}: unexpected indentation")
        elif line.startswith("- "):
            out += [".IP \\(bu 2", inline(line[2:], where)]
            state = "item"
        elif nxt.startswith(":   "):
            out += [".TP", inline(line, where)]
            state = "term"
        else:
            if state != "paragraph":
                out.append(".PP")
                state = "paragraph"
            out.append(inline(line, where))
    if in_code:
        raise SourceError(f"{name}: literal block without its closing {FENCE}")
    return "\n".join(out) + "\n"


def write_atomic(path, text):
    folder = os.path.dirname(os.path.abspath(path))
    fd, tmp = tempfile.mkstemp(prefix=".mkman.", dir=folder)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        print(f"mkman: {message}", file=sys.stderr)
        sys.exit(2)


def main(argv):
    p = Parser(prog="tools/mkman", description="Make a roff man page from its Markdown source.")
    p.add_argument("source", help="the Markdown source, for example docs/motanka.1.md")
    g = p.add_mutually_exclusive_group()
    g.add_argument("-o", "--output", help="write the man page to this file")
    g.add_argument("--check", metavar="FILE", help="fail when FILE is not what SOURCE makes")
    args = p.parse_args(argv)
    try:
        with open(args.source, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        print(f"mkman: cannot read {args.source}: {e}", file=sys.stderr)
        return 2
    try:
        roff = convert(text, os.path.basename(args.source))
    except SourceError as e:
        print(f"mkman: {e}", file=sys.stderr)
        return 2
    if args.check:
        try:
            with open(args.check, encoding="utf-8") as f:
                have = f.read()
        except (OSError, UnicodeDecodeError) as e:
            print(f"mkman: cannot read {args.check}: {e}", file=sys.stderr)
            return 2
        if have != roff:
            sys.stdout.writelines(difflib.unified_diff(
                have.splitlines(True), roff.splitlines(True),
                fromfile=args.check, tofile=f"tools/mkman {args.source}"))
            print(f"mkman: {args.check} is not current; regenerate it with "
                  f"python3 tools/mkman {args.source} -o {args.check}", file=sys.stderr)
            return 1
        print(f"mkman: {args.check} is current", file=sys.stderr)
        return 0
    if args.output:
        try:
            write_atomic(args.output, roff)
        except OSError as e:
            print(f"mkman: cannot write {args.output}: {e}", file=sys.stderr)
            return 2
        return 0
    sys.stdout.write(roff)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
