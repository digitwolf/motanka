#!/usr/bin/env python3
"""Check the content of Motanka .deb files against the design's file layout.

Usage: tools/debcheck <file.deb>...

Fails on:
  - any path outside the File layout table of
    .kiro/specs/motanka-layer/design.md (LAYOUT below);
  - any entry under /etc/ld.so.conf.d, /etc/sudoers.d, /etc/profile.d or
    /etc/sysctl.d (requirements 3.12, 5.3, 8.8);
  - any setuid or setgid entry (3.11);
  - any file capability: a security.capability xattr in the data tarball,
    or a setcap or filecap call in a maintainer script (3.11).

Prints one line per problem: <deb>: <path>: <reason>.
Exit codes: 0 no problem, 1 problems found, 2 usage or input error.

Needs dpkg-deb, so it runs inside a test VM or a build chroot. Written in
Python because it reads tar members (modes, pax headers) whose names may
contain any byte, which a Bash parser of `tar -tv` output gets wrong.
"""

import fnmatch
import re
import subprocess
import sys
import tarfile

# Allowed paths. "*" and "?" match within one path component, "**" matches
# any number of components (including none). "<pkg>" is the package name.
# Directories that lead to an allowed path are allowed too.
LAYOUT = (
    "/opt/motanka/**",
    "/usr/bin/motanka",
    "/usr/share/wayland-sessions/motanka.desktop",
    "/usr/lib/systemd/user/motanka-*",
    "/usr/lib/systemd/user/motanka-*.wants/*",
    "/usr/share/polkit-1/actions/org.motanka.policy",
    "/etc/dconf/profile/motanka",
    "/etc/dconf/db/motanka.d/**",
    "/usr/share/xdg-desktop-portal/motanka-portals.conf",
    "/etc/apparmor.d/motanka-*",
    "/usr/share/keyrings/motanka-archive-keyring.gpg",
    "/etc/apt/preferences.d/motanka",
    "/etc/apt/sources.list.d/motanka.sources",
    "/usr/share/doc/<pkg>/**",
    "/usr/share/man/man*/motanka*",
    "/usr/share/man/*/man*/motanka*",
    "/usr/share/bash-completion/completions/motanka",
    "/usr/share/zsh/vendor-completions/_motanka",
    "/usr/share/lintian/overrides/<pkg>",
)

FORBIDDEN_DIRS = (
    "/etc/ld.so.conf.d",
    "/etc/sudoers.d",
    "/etc/profile.d",
    "/etc/sysctl.d",
)

MAINTAINER_SCRIPTS = ("preinst", "postinst", "prerm", "postrm", "config")
CAP_CALL_RE = re.compile(rb"(^|[^A-Za-z0-9_.-])(setcap|filecap)([^A-Za-z0-9_.-]|$)", re.M)
CAP_XATTR = "security.capability"


class InputError(Exception):
    pass


def split(path):
    return [p for p in path.split("/") if p]


def full_match(parts, pats):
    if not pats:
        return not parts
    if pats[0] == "**":
        return any(full_match(parts[i:], pats[1:]) for i in range(len(parts) + 1))
    if not parts:
        return False
    return fnmatch.fnmatchcase(parts[0], pats[0]) and full_match(parts[1:], pats[1:])


def leads_to(parts, pats):
    """True if a directory at <parts> is a strict ancestor of a match."""
    if not parts:
        return bool(pats)
    if not pats:
        return False
    if pats[0] == "**":
        return True
    return fnmatch.fnmatchcase(parts[0], pats[0]) and leads_to(parts[1:], pats[1:])


def layout_for(pkg):
    escaped = re.sub(r"([*?\[])", r"[\1]", pkg)
    return [split(p.replace("<pkg>", escaped)) for p in LAYOUT]


def allowed(path, is_dir, layout):
    parts = split(path)
    if any(full_match(parts, pats) for pats in layout):
        return True
    return is_dir and any(leads_to(parts, pats) for pats in layout)


def under(path, folder):
    return path.startswith(folder + "/")


def norm(name):
    """Tar member name ("./usr/bin/x", "./", ".") to an absolute path."""
    if name.startswith("./"):
        name = name[2:]
    elif name == ".":
        name = ""
    return "/" + name.strip("/")


def run_dpkg_deb(args):
    try:
        res = subprocess.run(["dpkg-deb", *args], capture_output=True, check=False)
    except FileNotFoundError as e:
        raise InputError("dpkg-deb not found; run debcheck inside a test VM") from e
    if res.returncode != 0:
        msg = res.stderr.decode("utf-8", "replace").strip()
        raise InputError(f"dpkg-deb {' '.join(args)} failed: {msg}")
    return res.stdout


def tar_members(args):
    """Yields (member, content-or-None) for each member of a dpkg-deb tar
    stream; content is read for maintainer scripts only."""
    proc = subprocess.Popen(["dpkg-deb", *args], stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE)
    try:
        with tarfile.open(fileobj=proc.stdout, mode="r|*") as tar:
            for m in tar:
                content = None
                if m.isfile() and norm(m.name).lstrip("/") in MAINTAINER_SCRIPTS:
                    f = tar.extractfile(m)
                    content = f.read() if f else b""
                yield m, content
    except tarfile.TarError as e:
        raise InputError(f"dpkg-deb {' '.join(args)}: bad tar stream: {e}") from e
    finally:
        # tarfile stops at the end-of-archive marker; read the rest of the
        # record padding so dpkg-deb does not die of SIGPIPE.
        while proc.stdout.read(65536):
            pass
        proc.stdout.close()
        err = proc.stderr.read()
        proc.stderr.close()
        if proc.wait() != 0:
            msg = err.decode("utf-8", "replace").strip()
            raise InputError(f"dpkg-deb {' '.join(args)} failed: {msg}")


def check_deb(deb):
    problems = []
    pkg = run_dpkg_deb(["--field", deb, "Package"]).decode().strip()
    if not pkg:
        raise InputError(f"{deb}: no Package field")
    layout = layout_for(pkg)

    for m, _ in tar_members(["--fsys-tarfile", deb]):
        path = norm(m.name)
        for folder in FORBIDDEN_DIRS:
            if under(path, folder):
                problems.append((path, f"file under {folder} is forbidden"))
        if not allowed(path, m.isdir(), layout):
            problems.append((path, "outside the file layout"))
        if not m.issym() and m.mode & 0o4000:
            problems.append((path, "setuid bit set"))
        if not m.issym() and m.mode & 0o2000:
            problems.append((path, "setgid bit set"))
        if any(CAP_XATTR in k for k in m.pax_headers):
            problems.append((path, "file capability (security.capability xattr)"))

    for m, content in tar_members(["--ctrl-tarfile", deb]):
        if content is not None and CAP_CALL_RE.search(content):
            name = norm(m.name).lstrip("/")
            problems.append((f"DEBIAN/{name}", "maintainer script sets file capabilities (setcap or filecap)"))
    return problems


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: tools/debcheck <file.deb>...", file=sys.stderr)
        return 0 if argv else 2
    sys.stdout.reconfigure(errors="backslashreplace")
    found = 0
    for deb in argv:
        try:
            problems = check_deb(deb)
        except (InputError, OSError) as e:
            print(f"debcheck: {e}", file=sys.stderr)
            return 2
        for path, reason in problems:
            print(f"{deb}: {path}: {reason}")
        found += len(problems)
    if found:
        print(f"debcheck: {found} problem(s)", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
