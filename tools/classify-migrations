#!/usr/bin/env python3
"""Classify Upstream's migrations for Motanka (requirement 9.6).

usage: tools/classify-migrations [--upstream DIR] [--inventory FILE]
                                 [--home-paths FILE] [--overrides DIR]
                                 [--overrides-list FILE]
                                 [-o FILE | --check FILE]

Prints compat/migrations.tsv for the Upstream tree: one line per
migrations/<id>.sh, fields separated by tabs:
  <id>  ok|override|n/a  <note>
Defaults, relative to this repository:
  --upstream        .cache/upstream/omarchy (tools/fetch-upstream, tools/vendor)
  --inventory       compat/inventory/<stable commit of upstream.pin>.tsv
  --home-paths      compat/home-paths.tsv
  --overrides       src/overrides
  --overrides-list  compat/overrides.tsv
-o writes the file (through a temporary file and a rename); --check
compares an existing file with the output, prints a unified diff and exits 1
when they differ. The motanka-core build runs --check on the tree it
packages.

Rules, in order; the first that applies decides:
  1. override  src/overrides/migrations/<id>.sh exists.
  2. n/a       the Call_Inventory has an arch-tool, arch-path, privileged,
               user-unit or session finding for the migration, or a
               home-write whose target is outside the Namespaced_Paths and
               the namespaced and session globs of home-paths.tsv. Note:
               "Call_Inventory: <classes>".
  3. n/a       any of these, the note lists each in this order:
               - "uses <file>": an omarchy-path finding names an Upstream
                 file that rule 2 or the text checks below block, or a bin/
                 command whose override is unsupported in overrides.tsv;
               - "runs migrations/<id>.sh": it names another migration that
                 is n/a;
               - "calls <commands>": a line that is not a comment names an
                 Upstream bin/ command other than the read-only ones in
                 QUERY_COMMANDS (and omarchy-hw-*);
               - "home paths outside the Namespaced_Paths and session
                 configs": a $HOME/, ${HOME}/ or ~/ path outside them
                 (${XDG_*_HOME:-$HOME/...} counts as its default);
               - "runs <tools>": dconf, gsettings, mise, xdg-mime or
                 xdg-settings, which write per-user state outside the
                 Namespaced_Paths.
  4. ok        "no blocking finding".
The text checks are deliberately coarse: they also match names in strings
and messages. A false n/a only skips a migration; a false ok could change
the Host. The review of an Upstream_Pin bump reads every new ok migration.

Exit codes: 0 done, 1 --check found differences, 2 usage or input error.
Python 3 standard library only.
"""

import argparse
import difflib
import os
import re
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)

HEADER = [
    "# migrations.tsv: the class of each Upstream migration at the pin",
    "# (design.md, Data Models; requirement 9.6). Generated by",
    "# tools/classify-migrations; do not edit by hand. Installed as",
    "# /opt/motanka/share/motanka/migrations.tsv and read by the migration",
    "# runner, src/overrides/omarchy-migrate.",
    "#",
    "# Fields, separated by tabs:",
    "#   <migration-id>  ok|override|n/a  <note>",
    "#   ok        the runner runs the Upstream script unchanged",
    "#   override  the runner runs src/overrides/migrations/<migration-id>.sh",
    "#   n/a       the runner records it as done in Upstream's state format",
    "#             without running it",
    "# The rules are in tools/classify-migrations. A migration is n/a when the",
    "# Call_Inventory has an Arch, privileged, unit, session or non-namespaced",
    "# home finding for it, or when it uses such a file, runs an n/a migration,",
    "# calls an Upstream command that is not read-only, names a home path",
    "# outside the Namespaced_Paths and session configs, or runs a tool that",
    "# writes per-user state elsewhere.",
]

DIRECT_CLASSES = ("arch-tool", "arch-path", "privileged", "user-unit", "session", "home-write")
NAMESPACED = (
    ".config/dconf/motanka",
    ".config/omarchy",
    ".local/share/omarchy",
    ".local/state/omarchy",
    ".local/state/motanka",
    ".cache/omarchy",
    ".cache/motanka",
)
QUERY_COMMANDS = frozenset({
    "omarchy-cmd-missing",
    "omarchy-cmd-present",
    "omarchy-pkg-missing",
    "omarchy-pkg-present",
    "omarchy-state",
    "omarchy-version",
    "omarchy-version-channel",
})
QUERY_PREFIX = "omarchy-hw-"
HOME_TOOLS = ("dconf", "gsettings", "mise", "xdg-mime", "xdg-settings")
HOME_REASON = "home paths outside the Namespaced_Paths and session configs"

ID_RE = re.compile(r"^[0-9]+$")
MIG_REF_RE = re.compile(r"^migrations/([0-9]+)\.sh$")
PIN_RE = re.compile(r"^[0-9a-f]{40}$")
CALL_RE = re.compile(r"(?<![A-Za-z0-9_.\-])(omarchy-[a-z0-9]+(?:-[a-z0-9]+)*)(?![A-Za-z0-9_.\-])")
TOOL_RE = re.compile(r"(?<![A-Za-z0-9_./\-])(dconf|gsettings|mise|xdg-mime|xdg-settings)(?![A-Za-z0-9_.\-])")
XDG_RE = re.compile(r"\$\{XDG_(?:CONFIG|DATA|STATE|CACHE)_HOME:-(\$HOME/[A-Za-z0-9._/-]*)\}")
HOME_RE = re.compile(r"(?:\$HOME|\$\{HOME\}|(?<![A-Za-z0-9_])~)/([A-Za-z0-9._/-]*)")
OMARCHY_PREFIXES = ("$OMARCHY_PATH/", "${OMARCHY_PATH}/", "/usr/share/omarchy/")


class InputError(Exception):
    pass


def read_lines(path, what):
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as f:
            return f.read().splitlines()
    except OSError as e:
        raise InputError(f"cannot read {what} {path}: {e}")


def glob_re(glob):
    """The glob as an anchored regular expression, as src/libexec/user-setup reads it."""
    out, i = [], 0
    while i < len(glob):
        c = glob[i]
        if c == "*":
            if glob[i + 1:i + 2] == "*":
                out.append(".*")
                i += 2
                continue
            out.append("[^/]*")
        elif c == "?":
            out.append("[^/]")
        elif re.match(r"[A-Za-z0-9_/-]", c):
            out.append(c)
        else:
            out.append(re.escape(c))
        i += 1
    return re.compile("^" + "".join(out) + "$")


class Classifier:
    def __init__(self, upstream, inventory, home_paths, overrides, overrides_list):
        self.upstream = upstream
        self.overrides = overrides
        self.inventory_name = os.path.basename(inventory)
        mig_dir = os.path.join(upstream, "migrations")
        if not os.path.isdir(mig_dir):
            raise InputError(f"{upstream} has no migrations/ folder (fetch it with tools/fetch-upstream and tools/vendor)")
        self.ids = []
        for name in sorted(os.listdir(mig_dir)):
            if not name.endswith(".sh") or not os.path.isfile(os.path.join(mig_dir, name)):
                continue
            mid = name[:-3]
            if not ID_RE.match(mid):
                raise InputError(f"migrations/{name}: a migration name must be <digits>.sh")
            self.ids.append(mid)
        bin_dir = os.path.join(upstream, "bin")
        if not os.path.isdir(bin_dir):
            raise InputError(f"{upstream} has no bin/ folder")
        self.commands = frozenset(n for n in os.listdir(bin_dir) if os.path.isfile(os.path.join(bin_dir, n)))
        self.findings = {}
        for n, line in enumerate(read_lines(inventory, "the Call_Inventory"), 1):
            if not line:
                continue
            parts = line.split("\t", 3)
            if len(parts) != 4:
                raise InputError(f"{inventory}:{n}: expected 4 tab-separated fields")
            self.findings.setdefault(parts[0], []).append((parts[2], parts[3]))
        self.globs = []
        for n, line in enumerate(read_lines(home_paths, "the home paths"), 1):
            if not line.strip() or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) < 2:
                raise InputError(f"{home_paths}:{n}: expected <glob> TAB <class>")
            self.globs.append((glob_re(parts[0]), parts[1]))
        self.override_choice = {}
        for n, line in enumerate(read_lines(overrides_list, "the overrides list"), 1):
            if not line.strip() or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) != 3:
                raise InputError(f"{overrides_list}:{n}: expected 3 tab-separated fields")
            self.override_choice[parts[0]] = parts[1]
        self.memo = {}

    # --- home paths ---------------------------------------------------------

    def home_class(self, rel):
        for rx, cls in self.globs:
            if rx.match(rel):
                return cls
        return None

    def home_allowed(self, rel):
        rel = rel.rstrip("/")
        if not rel:
            return False
        for ns in NAMESPACED:
            if rel == ns or rel.startswith(ns + "/"):
                return True
        return any(self.home_class(c) in ("namespaced", "session") for c in (rel, rel + "/x"))

    def home_write_allowed(self, detail):
        d = detail
        if d.endswith(" ?"):
            d = d[:-2]
        if d.endswith(" [namespaced]"):
            return True
        if not d.startswith("~/"):
            return False
        return self.home_allowed(d[2:])

    # --- checks ---------------------------------------------------------------

    def direct(self, rel):
        """Blocking Call_Inventory classes of an Upstream file, in DIRECT_CLASSES order."""
        found = set()
        for cls, detail in self.findings.get(rel, []):
            if cls in DIRECT_CLASSES[:-1]:
                found.add(cls)
            elif cls == "home-write" and not self.home_write_allowed(detail):
                found.add("home-write")
        return [c for c in DIRECT_CLASSES if c in found]

    def refs(self, rel):
        """Upstream paths an omarchy-path finding names, sorted."""
        out = set()
        for cls, detail in self.findings.get(rel, []):
            if cls != "omarchy-path":
                continue
            d = detail[:-2] if detail.endswith(" ?") else detail
            for p in OMARCHY_PREFIXES:
                if d.startswith(p) and len(d) > len(p):
                    out.add(d[len(p):])
        return sorted(out)

    def text(self, rel):
        """(calls, home paths outside, tools) found in the file's non-comment lines."""
        path = os.path.join(self.upstream, rel)
        calls, tools, home = set(), set(), False
        for line in read_lines(path, "the Upstream file"):
            if line.lstrip().startswith("#"):
                continue
            for m in CALL_RE.finditer(line):
                name = m.group(1)
                if name in self.commands and name not in QUERY_COMMANDS and not name.startswith(QUERY_PREFIX):
                    calls.add(name)
            for m in TOOL_RE.finditer(line):
                tools.add(m.group(1))
            for m in HOME_RE.finditer(XDG_RE.sub(r"\1", line)):
                if not self.home_allowed(m.group(1)):
                    home = True
        return sorted(calls), home, [t for t in HOME_TOOLS if t in tools]

    def text_reasons(self, rel):
        calls, home, tools = self.text(rel)
        reasons = []
        if calls:
            reasons.append("calls " + ", ".join(calls))
        if home:
            reasons.append(HOME_REASON)
        if tools:
            reasons.append("runs " + ", ".join(tools))
        return reasons

    def file_blocked(self, rel):
        if rel.startswith("bin/") and "/" not in rel[4:] and rel in self.override_choice:
            return self.override_choice[rel] == "unsupported"
        if self.direct(rel):
            return True
        if os.path.isfile(os.path.join(self.upstream, rel)):
            return bool(self.text_reasons(rel))
        return False

    def classify(self, mid, stack=()):
        if mid in self.memo:
            return self.memo[mid]
        rel = f"migrations/{mid}.sh"
        if os.path.isfile(os.path.join(self.overrides, "migrations", mid + ".sh")):
            result = ("override", f"Ubuntu version in src/overrides/migrations/{mid}.sh")
        else:
            cats = self.direct(rel)
            if cats:
                result = ("n/a", "Call_Inventory: " + ", ".join(cats))
            else:
                uses, runs = [], []
                for ref in self.refs(rel):
                    m = MIG_REF_RE.match(ref)
                    if m:
                        other = m.group(1)
                        if other != mid and other in self.ids and other not in stack:
                            if self.classify(other, stack + (mid,))[0] == "n/a":
                                runs.append(f"runs migrations/{other}.sh")
                        continue
                    if self.file_blocked(ref):
                        uses.append(f"uses {ref}")
                reasons = uses + runs + self.text_reasons(rel)
                if reasons:
                    result = ("n/a", "; ".join(reasons))
                else:
                    result = ("ok", "no blocking finding")
        self.memo[mid] = result
        return result

    def render(self):
        lines = list(HEADER)
        lines.append(f"# Call_Inventory: {self.inventory_name}")
        for mid in self.ids:
            cls, note = self.classify(mid)
            lines.append(f"{mid}\t{cls}\t{note}")
        return "\n".join(lines) + "\n"

    def counts(self):
        c = {"ok": 0, "override": 0, "n/a": 0}
        for mid in self.ids:
            c[self.classify(mid)[0]] += 1
        return c


def default_inventory():
    pin = os.path.join(REPO, "upstream.pin")
    for line in read_lines(pin, "the Upstream pin"):
        parts = line.split("\t")
        if len(parts) >= 2 and parts[0] == "stable" and PIN_RE.match(parts[1]):
            return os.path.join(REPO, "compat", "inventory", parts[1] + ".tsv")
    raise InputError(f"{pin} has no valid stable line")


def write_atomic(path, text):
    d = os.path.dirname(os.path.abspath(path))
    fd, tmp = tempfile.mkstemp(prefix=".migrations.", dir=d)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        print(f"classify-migrations: {message}", file=sys.stderr)
        sys.exit(2)


def main(argv):
    p = Parser(prog="tools/classify-migrations",
               description="Classify Upstream's migrations as ok, override or n/a for Motanka.")
    p.add_argument("--upstream", default=os.path.join(REPO, ".cache", "upstream", "omarchy"))
    p.add_argument("--inventory")
    p.add_argument("--home-paths", default=os.path.join(REPO, "compat", "home-paths.tsv"))
    p.add_argument("--overrides", default=os.path.join(REPO, "src", "overrides"))
    p.add_argument("--overrides-list", default=os.path.join(REPO, "compat", "overrides.tsv"))
    g = p.add_mutually_exclusive_group()
    g.add_argument("-o", "--output")
    g.add_argument("--check")
    args = p.parse_args(argv)
    try:
        inventory = args.inventory or default_inventory()
        c = Classifier(args.upstream, inventory, args.home_paths, args.overrides, args.overrides_list)
        text = c.render()
        n = c.counts()
        summary = f"{len(c.ids)} migrations: {n['ok']} ok, {n['override']} override, {n['n/a']} n/a"
        if args.check:
            try:
                with open(args.check, encoding="utf-8", errors="surrogateescape") as f:
                    have = f.read()
            except OSError as e:
                raise InputError(f"cannot read {args.check}: {e}")
            if have != text:
                sys.stdout.writelines(difflib.unified_diff(
                    have.splitlines(True), text.splitlines(True),
                    fromfile=args.check, tofile="tools/classify-migrations"))
                print(f"classify-migrations: {args.check} differs from the classification ({summary}); "
                      f"regenerate it with tools/classify-migrations -o {args.check} and review the changes",
                      file=sys.stderr)
                return 1
            print(f"classify-migrations: {args.check} is current ({summary})", file=sys.stderr)
            return 0
        if args.output:
            write_atomic(args.output, text)
        else:
            sys.stdout.write(text)
        print(f"classify-migrations: {summary}", file=sys.stderr)
        return 0
    except InputError as e:
        print(f"classify-migrations: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
