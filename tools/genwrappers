#!/bin/bash
# tools/genwrappers: generate one Wrapper per file in Upstream's bin/ (design
# .md, "Wrappers, shims and the Helper").
#
# usage: tools/genwrappers [--runner PATH] <upstream-tree> <output-folder>
#
# For every regular file (or link to one) directly in <upstream-tree>/bin/,
# writes <output-folder>/<name>, mode 0755:
#
#   #!/bin/bash
#   # Motanka Wrapper for Upstream bin/<name>; generated by tools/genwrappers, do not edit.
#   set -euo pipefail
#   exec /opt/motanka/libexec/motanka/run-upstream <name> "$@"
#
# The package build writes them into /opt/motanka/bin, the only Motanka
# folder on the session PATH. run-upstream sets the Wrapper scope, so shims
# are found only below a Wrapper (5.9, 7.14). --runner replaces the
# run-upstream path (tests).
#
# The output folder is created when missing. Wrappers whose Upstream file is
# gone are deleted; a file there that is not a generated Wrapper stops the
# run. Each Wrapper is written to a temporary name and renamed into place.
#
# Exit codes: 0 written, 1 error, 2 usage.
set -euo pipefail

readonly MARKER='# Motanka Wrapper for Upstream bin/'
readonly NAME_RE='^[A-Za-z0-9][A-Za-z0-9._+-]*$'
runner=/opt/motanka/libexec/motanka/run-upstream

die() {
  local code=$1
  shift
  printf 'tools/genwrappers: %s\n' "$*" >&2
  exit "$code"
}

usage() {
  printf 'usage: tools/genwrappers [--runner PATH] <upstream-tree> <output-folder>\n'
}

positional=()
while (($# > 0)); do
  case $1 in
    --runner)
      (($# >= 2)) || die 2 "--runner needs a path"
      runner=$2
      shift 2
      ;;
    --runner=*)
      runner=${1#--runner=}
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      usage >&2
      die 2 "unknown option '$1'"
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done
if ((${#positional[@]} != 2)); then
  usage >&2
  die 2 "an Upstream tree and an output folder are required"
fi
tree=${positional[0]%/}
out=${positional[1]%/}
[[ $runner =~ ^/[A-Za-z0-9._/+-]+$ ]] || die 2 "the runner must be an absolute path of letters, digits and ._/+-"
[[ -d $tree/bin ]] || die 1 "$tree/bin is not a folder"
mkdir -p -- "$out" || die 1 "cannot create $out"

# is_wrapper <file>: 0 if the file is a Wrapper this tool generated.
is_wrapper() {
  local first="" second=""
  [[ -f $1 && ! -L $1 ]] || return 1
  {
    IFS= read -r first || true
    IFS= read -r second || true
  } <"$1"
  [[ $first == '#!/bin/bash' && $second == "$MARKER"* ]]
}

declare -A wanted=()
names=()
for f in "$tree"/bin/*; do
  [[ -f $f ]] || continue
  name=${f##*/}
  [[ $name =~ $NAME_RE ]] || die 1 "Upstream bin/ file name '$name' is not a valid command name"
  wanted[$name]=1
  names+=("$name")
done
((${#names[@]} > 0)) || die 1 "$tree/bin has no files"

for f in "$out"/* "$out"/.[!.]*; do
  [[ -e $f || -L $f ]] || continue
  name=${f##*/}
  if [[ $name == .*.genwrappers-tmp ]]; then
    rm -f -- "$f"
    continue
  fi
  if ! is_wrapper "$f"; then
    die 1 "$f is not a generated Wrapper; refusing to write into a folder with other files"
  fi
  if [[ -z ${wanted[$name]:-} ]]; then
    rm -f -- "$f"
  fi
done

count=0
for name in "${names[@]}"; do
  tmp=$out/.$name.genwrappers-tmp
  # shellcheck disable=SC2016 # "$@" is written into the Wrapper literally
  printf '#!/bin/bash\n%s%s; generated by tools/genwrappers, do not edit.\nset -euo pipefail\nexec %s %s "$@"\n' \
    "$MARKER" "$name" "$runner" "$name" >"$tmp"
  chmod 0755 "$tmp"
  mv -fT -- "$tmp" "$out/$name"
  count=$((count + 1))
done
printf 'tools/genwrappers: %d Wrappers in %s\n' "$count" "$out" >&2
