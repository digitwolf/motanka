#!/usr/bin/env bash
# Boot a throwaway test VM from a copy-on-write overlay.
#
# Usage: test/vm/up <resolute|noble> <fresh|gnome-snaps|kde|multiuser>
#        test/vm/up arch omarchy
#
# Builds the base image first if it is missing (test/vm/image). Waits until
# SSH answers and cloud-init has finished, at most 600 s. Prints the VM name
# as the last line on stdout; everything else goes to stderr. On failure the
# serial console tail is printed and the overlay is deleted.
#
# Then brings the VM up to date with apt-get full-upgrade, unless
# MOTANKA_VM_UPGRADE=0 (build and unit-test VMs need no current host).
#
# "arch omarchy" is the parity reference VM (test/vm/image): it is never
# upgraded, because its packages must stay those of Upstream's stable
# channel at the time the base image was built. Its Upstream session starts
# by itself (SDDM autologin of user alice); it needs MOTANKA_VM_GPU=gl.
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
MV_USAGE="test/vm/up <resolute|noble> <fresh|gnome-snaps|kde|multiuser> | test/vm/up arch omarchy"
mv_init

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  printf 'usage: %s\n' "$MV_USAGE"
  exit 0
fi
if (($# != 2)); then
  mv_usage
fi
release=$1
variant=$2
mv_check_image_target "$release" "$variant"
mv_check_kvm
mv_need qemu-system-x86_64 qemu-img ssh ssh-keygen python3 setsid timeout
mv_ensure_key

backing=$("$MV_LIB_DIR/image" "$release" "$variant" | tail -n 1)
if [[ ! -f $backing ]]; then
  mv_die "base image for $release $variant not found: $backing"
fi

mv_boot "$release" "$variant" "$backing"
# Tests compare Fingerprints and the Installer refuses to upgrade a host
# package (exit 5), so a test VM starts as an up-to-date host: the base
# images are cloud images of their release day plus provisioning, and an
# install from a stale image pulls archive updates (seen: libpcre2-8-0).
if [[ $release == "$MV_ARCH_RELEASE" ]]; then
  mv_log "not upgrading the reference VM $MV_BOOTED (its packages are those of its base image)"
elif [[ ${MOTANKA_VM_UPGRADE:-1} == 1 ]]; then
  mv_log "bringing $MV_BOOTED up to date (apt-get full-upgrade; MOTANKA_VM_UPGRADE=0 skips it)"
  mv_ssh_args "$MV_BOOTED"
  # sudo-rs (26.04) ignores sudo -E, so the variable goes through env.
  if ! "${MV_SSH[@]}" 'sudo env DEBIAN_FRONTEND=noninteractive apt-get -q update &&
    sudo env DEBIAN_FRONTEND=noninteractive apt-get -q -y \
      -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade' \
    </dev/null >"$MV_VMS/$MV_BOOTED/upgrade.log" 2>&1; then
    tail -n 20 "$MV_VMS/$MV_BOOTED/upgrade.log" >&2 || true
    mv_die "apt-get full-upgrade failed in $MV_BOOTED"
  fi
  if [[ -n ${MOTANKA_VM_RESULTS:-} && -d ${MOTANKA_VM_RESULTS:-} ]]; then
    cp -f "$MV_VMS/$MV_BOOTED/upgrade.log" "$MOTANKA_VM_RESULTS/$MV_BOOTED.upgrade.log" || true
  fi
fi
mv_unregister "$MV_BOOTED"
mv_log "ready: $MV_BOOTED (SSH on 127.0.0.1:$(<"$MV_VMS/$MV_BOOTED/ssh.port"))"
printf '%s\n' "$MV_BOOTED"
