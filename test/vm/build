#!/usr/bin/env bash
# Build Motanka source packages for noble and resolute inside a throwaway
# build VM. Nothing is built or installed on the host.
#
# Usage: test/vm/build [--keep] [--vm <name>] [--suite noble|resolute|all]
#                      <package-dir>...
#
#   --suite   suite to build for (default all: noble and resolute)
#   --vm      reuse a running VM instead of booting one; it is never torn down
#   --keep    keep the booted VM afterwards (also after a failure)
#
# Steps: boot a resolute fresh VM, push the repository, provision it with
# test/vm/build-provision.sh (idempotent), run packaging/build.sh once per
# suite, copy the results back, tear the VM down.
#
# Packages are built in the order given, so a package whose sbuild-local
# file names another one's .debs must come after it (for example
# packaging/motanka-qt6 before packaging/motanka-stack-shell).
#
# Build VM size: MOTANKA_BUILD_VM_CPUS (default host CPUs up to 10),
# MOTANKA_BUILD_VM_RAM (default 10G), MOTANKA_VM_DISK (default 40G). When a
# package with upstream components (motanka-stack, motanka-qt6,
# motanka-stack-shell) is among the packages, the defaults are host CPUs up
# to 16, half the host memory up to 16G (at least 10G) and an 80G disk; the
# Stack compiles about 3,000 C++ files, Qt several times that, and
# debian/rules runs one job per 2 GiB of guest memory.
#
# Upstream tarballs: a package that imports a components file
# (/stack/*components.tsv in its build-imports) gets its tarballs from
# stack/fetch-sources --components <file>, which runs on the host (it only
# downloads and verifies) and caches them in
# ~/.cache/motanka-vm/stack-src-tarballs/, so a rebuild downloads nothing.
# Only the tarballs of the packages being built are copied into the VM.
# Unpinned checksums stop the build; pin them with
# stack/fetch-sources --components <file> --update-checksums after review.
# A package whose suites file lists none of the requested suites is not
# fetched (packaging/build.sh skips it). A package that imports
# /upstream.pin (motanka-core) gets the pinned Upstream tarball from
# tools/fetch-upstream, cached in ~/.cache/motanka-vm/upstream-tarballs/.
#
# Local build dependencies: for each suite, the .debs that the packages'
# sbuild-local files name (<name>_<version>_{amd64,all}.deb) are copied
# from ~/.cache/motanka-vm/debs/<suite>/ into the VM when they exist there,
# and packaging/build.sh gets them with --extra-debs. A .deb built earlier
# in the same run takes precedence.
#
# Each suite's build runs detached inside the VM, so a dropped SSH
# connection does not kill it; the host polls its log every 15 s.
# MOTANKA_BUILD_TIMEOUT (seconds, default 28800) bounds one suite's build;
# on expiry the build is killed and the suite counts as failed.
#
# SOURCE_DATE_EPOCH is the date of the last git commit (or the value already
# in the environment). Results on the host:
#   ~/.cache/motanka-vm/debs/<suite>/      .deb, .ddeb, .changes, .buildinfo,
#                                          .dsc, source tarballs
#   <results>/build-<suite>/               sbuild, lintian and debcheck logs
# where <results> is MOTANKA_VM_RESULTS if set, otherwise
# ~/.cache/motanka-vm/results/<run-id>/. Prints the host path of every built
# .deb on stdout; everything else goes to stderr.
# Exit codes: 0 all built, 1 a build failed, 2 usage error.
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"
MV_USAGE="test/vm/build [--keep] [--vm <name>] [--suite noble|resolute|all] <package-dir>..."
mv_init

STACK_TARBALLS=$MV_STATE/stack-src-tarballs
UPSTREAM_TARBALLS=$MV_STATE/upstream-tarballs
POLL=15

keep_vm=false
vm=""
suite_arg=all
pkgs=()
while (($# > 0)); do
  case $1 in
    --keep)
      keep_vm=true
      shift
      ;;
    --vm | --suite)
      if (($# < 2)); then
        mv_usage "$1 needs a value"
      fi
      if [[ $1 == --vm ]]; then vm=$2; else suite_arg=$2; fi
      shift 2
      ;;
    -h | --help)
      printf 'usage: %s\n' "$MV_USAGE"
      exit 0
      ;;
    -*) mv_usage "unknown option '$1'" ;;
    *)
      pkgs+=("$1")
      shift
      ;;
  esac
done
case $suite_arg in
  all) suites=(noble resolute) ;;
  noble | resolute) suites=("$suite_arg") ;;
  *) mv_usage "--suite must be noble, resolute or all" ;;
esac
if ((${#pkgs[@]} == 0)); then
  mv_usage "no package folder given"
fi
timeout_s=${MOTANKA_BUILD_TIMEOUT:-28800}
if [[ ! $timeout_s =~ ^[1-9][0-9]*$ ]]; then
  mv_usage "MOTANKA_BUILD_TIMEOUT must be a positive number of seconds, got '$timeout_s'"
fi
mv_need ssh ssh-keygen tar git

# components_of <pkg-dir>: prints the components files (repository-relative)
# that the package's build-imports names.
components_of() {
  local line
  [[ -f $1/build-imports ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    line=${line//[[:space:]]/}
    if [[ $line =~ ^/stack/[A-Za-z0-9._-]*components\.tsv$ ]]; then
      printf '%s\n' "${line#/}"
    fi
  done <"$1/build-imports"
}

# builds_for <pkg-dir> <suite>: the package's suites file (if any) lists the
# suite.
builds_for() {
  local line word
  local -a words
  [[ -f $1/suites ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    read -r -a words <<<"${line%%#*}"
    for word in "${words[@]}"; do
      [[ $word == "$2" ]] && return 0
    done
  done <"$1/suites"
  return 1
}

# source_of <pkg-dir>: prints the Source field of debian/control(.in).
source_of() {
  local c=$1/debian/control
  [[ -f $c ]] || c=$1/debian/control.in
  sed -n 's/^Source:[[:space:]]*//p' "$c" | head -n 1
}

# local_names <pkg-dir> <suite>: prints the binary packages the package's
# sbuild-local file names for the suite.
local_names() {
  local rsuite rest
  local -a names
  [[ -f $1/sbuild-local ]] || return 0
  while read -r rsuite rest || [[ -n $rsuite ]]; do
    if [[ -z $rsuite || $rsuite == \#* || $rsuite != "$2" ]]; then
      continue
    fi
    read -r -a names <<<"${rest%%#*}"
    if ((${#names[@]} > 0)); then
      printf '%s\n' "${names[@]}"
    fi
  done <"$1/sbuild-local"
}

guest_pkgs=()
abs_pkgs=()
big=false
for p in "${pkgs[@]}"; do
  if [[ ! -d $p ]]; then
    mv_die "no such folder: $p"
  fi
  abs=$(cd "$p" && pwd)
  if [[ $abs != "$MV_REPO"/* ]]; then
    mv_die "$p is not inside the repository $MV_REPO"
  fi
  if [[ ! -f $abs/debian/control && ! -f $abs/debian/control.in ]]; then
    mv_die "$p has no debian/control or debian/control.in"
  fi
  wanted=false
  for s in "${suites[@]}"; do
    if builds_for "$abs" "$s"; then
      wanted=true
    fi
  done
  if $wanted && [[ -n $(components_of "$abs") ]]; then
    big=true
  fi
  abs_pkgs+=("$abs")
  guest_pkgs+=("$MV_GUEST_REPO/${abs#"$MV_REPO"/}")
done

if [[ ${SOURCE_DATE_EPOCH:-} =~ ^[0-9]+$ ]]; then
  sde=$SOURCE_DATE_EPOCH
else
  sde=$(git -C "$MV_REPO" log -1 --format=%ct 2>/dev/null || true)
  if [[ ! $sde =~ ^[0-9]+$ ]]; then
    mv_die "cannot read the last commit date with git; commit first or set SOURCE_DATE_EPOCH"
  fi
fi
if [[ -n $(git -C "$MV_REPO" status --porcelain 2>/dev/null || true) ]]; then
  mv_log "warning: the working tree has uncommitted changes; SOURCE_DATE_EPOCH=$sde is the last commit date"
fi

run_id="$(date -u +%Y%m%dT%H%M%SZ)-$(mv_hex6)"
results=${MOTANKA_VM_RESULTS:-$MV_RESULTS/$run_id}
mkdir -p "$results"
export MOTANKA_VM_RESULTS="$results"

# Upstream sources, verified on the host before any VM boots. Only the
# orig-<component> tarballs of the packages being built go into the VM.
orig_host=""
upstream_ver=$(bash "$MV_REPO/packaging/version.sh" resolute)
upstream_ver=${upstream_ver%%-*}
for abs in "${abs_pkgs[@]}"; do
  wanted=false
  for s in "${suites[@]}"; do
    if builds_for "$abs" "$s"; then
      wanted=true
    fi
  done
  $wanted || continue
  mapfile -t comp_files < <(components_of "$abs")
  ((${#comp_files[@]} > 0)) || continue
  src=$(source_of "$abs")
  if [[ ! $src =~ ^motanka[a-z0-9+.-]*$ ]]; then
    mv_die "${abs#"$MV_REPO"/} has no valid Source field"
  fi
  mv_need python3
  for cf in "${comp_files[@]}"; do
    tag=$(basename "$cf" .tsv)
    mv_log "fetching and verifying the sources of $src ($cf) into $STACK_TARBALLS"
    if ! python3 "$MV_REPO/stack/fetch-sources" --components "$MV_REPO/$cf" --out "$STACK_TARBALLS" \
      >"$results/fetch-sources-$tag.out" 2> >(tee "$results/fetch-sources-$tag.log" >&2); then
      mv_die "stack/fetch-sources --components $cf failed; log: $results/fetch-sources-$tag.log"
    fi
    got=$(tail -n 1 "$results/fetch-sources-$tag.out")
    if [[ $got != "$STACK_TARBALLS"/* || ! -d $got ]]; then
      mv_die "stack/fetch-sources printed an unexpected folder '$got'"
    fi
    if [[ -z $orig_host ]]; then
      orig_host="$MV_STATE/.origs-$run_id"
      MV_CLEANUP_PATHS+=("$orig_host")
      mkdir -p "$orig_host"
    fi
    shopt -s nullglob
    for f in "$got/${src}_${upstream_ver}.orig-"*; do
      ln -f "$f" "$orig_host/" 2>/dev/null || cp -f "$f" "$orig_host/"
    done
    shopt -u nullglob
  done
done

# The vendored Upstream: a package that imports /upstream.pin (motanka-core)
# gets the pinned Upstream tarball as its orig-omarchy component from
# tools/fetch-upstream, which runs on the host (it only downloads and
# verifies) and caches it in ~/.cache/motanka-vm/upstream-tarballs/.
for abs in "${abs_pkgs[@]}"; do
  [[ -f $abs/build-imports ]] || continue
  grep -Eq '^[[:space:]]*/upstream\.pin[[:space:]]*(#.*)?$' "$abs/build-imports" || continue
  src=$(source_of "$abs")
  if [[ ! $src =~ ^motanka[a-z0-9+.-]*$ ]]; then
    mv_die "${abs#"$MV_REPO"/} has no valid Source field"
  fi
  mv_need python3
  mv_log "fetching and verifying the Upstream tarball for $src into $UPSTREAM_TARBALLS"
  if ! python3 "$MV_REPO/tools/fetch-upstream" --source "$src" --out "$UPSTREAM_TARBALLS" \
    >"$results/fetch-upstream-$src.out" 2> >(tee "$results/fetch-upstream-$src.log" >&2); then
    mv_die "tools/fetch-upstream failed for $src; log: $results/fetch-upstream-$src.log"
  fi
  got=$(tail -n 1 "$results/fetch-upstream-$src.out")
  if [[ $got != "$UPSTREAM_TARBALLS"/* || ! -d $got ]]; then
    mv_die "tools/fetch-upstream printed an unexpected folder '$got'"
  fi
  if [[ -z $orig_host ]]; then
    orig_host="$MV_STATE/.origs-$run_id"
    MV_CLEANUP_PATHS+=("$orig_host")
    mkdir -p "$orig_host"
  fi
  shopt -s nullglob
  for f in "$got/${src}_${upstream_ver}.orig-omarchy."*; do
    ln -f "$f" "$orig_host/" 2>/dev/null || cp -f "$f" "$orig_host/"
  done
  shopt -u nullglob
done

# Locally built build dependencies, per suite, from the host's .deb cache.
local_host="$MV_STATE/.local-debs-$run_id"
MV_CLEANUP_PATHS+=("$local_host")
declare -A have_local=()
for s in "${suites[@]}"; do
  sver=$(bash "$MV_REPO/packaging/version.sh" "$s")
  for abs in "${abs_pkgs[@]}"; do
    builds_for "$abs" "$s" || continue
    while IFS= read -r name; do
      [[ $name =~ ^motanka(-[a-z0-9][a-z0-9+.-]*)?$ ]] || mv_die "${abs#"$MV_REPO"/}/sbuild-local: invalid package name '$name'"
      for f in "$MV_DEBS/$s/${name}_${sver}_amd64.deb" "$MV_DEBS/$s/${name}_${sver}_all.deb"; do
        if [[ -f $f ]]; then
          mkdir -p "$local_host/$s"
          ln -f "$f" "$local_host/$s/" 2>/dev/null || cp -f "$f" "$local_host/$s/"
          have_local[$s]=1
          break
        fi
      done
    done < <(local_names "$abs" "$s")
  done
done

if [[ -n $vm ]]; then
  mv_require_running "$vm"
  booted=false
else
  mv_check_kvm
  mv_need qemu-system-x86_64 qemu-img python3 setsid timeout
  if $big; then
    host_cpus=$(nproc 2>/dev/null || echo 4)
    ((host_cpus <= 16)) || host_cpus=16
    host_mem_g=$(awk '$1 == "MemTotal:" { print int($2 / 1048576) }' /proc/meminfo 2>/dev/null || echo 20)
    stack_ram=$((host_mem_g / 2))
    ((stack_ram <= 16)) || stack_ram=16
    ((stack_ram >= 10)) || stack_ram=10
    export MOTANKA_BUILD_VM_CPUS=${MOTANKA_BUILD_VM_CPUS:-$host_cpus}
    export MOTANKA_BUILD_VM_RAM=${MOTANKA_BUILD_VM_RAM:-${stack_ram}G}
    export MOTANKA_VM_DISK=${MOTANKA_VM_DISK:-80G}
  fi
  mv_up_build_vm
  vm=$MV_BOOTED
  booted=true
  if $keep_vm; then
    mv_unregister "$vm"
  fi
fi
run() { "$MV_LIB_DIR/run" "$vm" -- "$@" </dev/null; }

mv_log "build $run_id in $vm for ${suites[*]}: ${pkgs[*]} (SOURCE_DATE_EPOCH=$sde)"
"$MV_LIB_DIR/push" "$vm" </dev/null
if ! run bash "$MV_GUEST_REPO/test/vm/build-provision.sh" "${suites[@]}" 2>&1 |
  tee "$results/build-provision.log" >&2; then
  mv_die "provisioning $vm failed; log: $results/build-provision.log"
fi

guest_base="/home/$MV_GUEST_USER/motanka-build/$run_id"
orig_args=()
if [[ -n $orig_host ]]; then
  mv_log "copying the upstream sources ($(du -sh "$orig_host" | cut -f1)) into $vm"
  mv_copy_to_vm "$vm" "$orig_host" "$guest_base/origs"
  orig_args=(--orig-dir "$guest_base/origs")
fi
for s in "${suites[@]}"; do
  if [[ -n ${have_local[$s]:-} ]]; then
    mv_log "copying local build dependencies for $s into $vm: $(cd "$local_host/$s" && echo *.deb)"
    mv_copy_to_vm "$vm" "$local_host/$s" "$guest_base/local-debs/$s"
  fi
done

# build_suite <suite> <guest-out>: runs packaging/build.sh detached in the VM
# and streams its log into <results>/build-<suite>.log. Returns its exit code.
build_suite() {
  local suite=$1 guest_out=$2 hostlog=$results/build-$1.log
  local glog="$guest_base/$1.log" grc="$guest_base/$1.rc" pgid size rc fails=0 deadline q_log q_rc
  local -a extra_args=()
  if [[ -n ${have_local[$suite]:-} ]]; then
    extra_args=(--extra-debs "$guest_base/local-debs/$suite")
  fi
  printf -v q_log '%q' "$glog"
  printf -v q_rc '%q' "$grc"
  : >"$hostlog"
  pgid=$(
    "$MV_LIB_DIR/run" "$vm" -- bash -s -- "$glog" "$grc" "$sde" \
      "$MV_GUEST_REPO/packaging/build.sh" --suite "$suite" --out "$guest_out" \
      "${orig_args[@]}" "${extra_args[@]}" "${guest_pkgs[@]}" <<'EOS'
set -euo pipefail
log=$1 rcf=$2 sde=$3
shift 3
mkdir -p "$(dirname "$log")"
rm -f -- "$rcf" "$rcf.tmp"
: >"$log"
# setsid in a non-interactive shell's background job does not fork, so $!
# is the new session's (and process group's) leader.
nohup setsid bash -c '
  log=$1 rcf=$2
  shift 2
  rc=0
  "$@" >>"$log" 2>&1 || rc=$?
  echo "$rc" >"$rcf.tmp"
  mv -f "$rcf.tmp" "$rcf"
' launcher "$log" "$rcf" env SOURCE_DATE_EPOCH="$sde" bash "$@" </dev/null >/dev/null 2>&1 &
echo "$!"
EOS
  )
  if [[ ! $pgid =~ ^[0-9]+$ ]]; then
    mv_log "could not start the $suite build in $vm"
    return 1
  fi
  mv_log "$suite build started in $vm (process group $pgid, timeout ${timeout_s} s)"
  deadline=$((SECONDS + timeout_s))
  while :; do
    sleep "$POLL"
    size=$(stat -c %s "$hostlog")
    if "$MV_LIB_DIR/run" "$vm" -- "tail -c +$((size + 1)) -- $q_log" </dev/null 2>/dev/null |
      tee -a "$hostlog" >&2; then
      fails=0
    else
      fails=$((fails + 1))
      if ((fails >= 20)); then
        mv_log "lost contact with $vm for $((fails * POLL)) s"
        return 1
      fi
      continue
    fi
    if run "test -s $q_rc" 2>/dev/null; then
      size=$(stat -c %s "$hostlog")
      "$MV_LIB_DIR/run" "$vm" -- "tail -c +$((size + 1)) -- $q_log" </dev/null 2>/dev/null |
        tee -a "$hostlog" >&2 || true
      rc=$(run "cat $q_rc" 2>/dev/null || echo 1)
      [[ $rc =~ ^[0-9]+$ ]] || rc=1
      return "$rc"
    fi
    if ((SECONDS >= deadline)); then
      mv_log "the $suite build exceeded MOTANKA_BUILD_TIMEOUT=${timeout_s} s; killing it"
      run "kill -TERM -- -$pgid; sleep 10; kill -KILL -- -$pgid" >/dev/null 2>&1 || true
      return 124
    fi
  done
}

failed=()
for suite in "${suites[@]}"; do
  guest_out="$guest_base/$suite"
  rc=0
  build_suite "$suite" "$guest_out" || rc=$?
  if ((rc != 0)); then
    mv_log "$suite build failed (exit $rc)"
    failed+=("$suite")
  fi

  tmp="$MV_STATE/.build-$run_id-$suite"
  MV_CLEANUP_PATHS+=("$tmp")
  if ! mv_copy_from_vm "$vm" "$guest_out" "$tmp"; then
    mv_log "could not copy results of $suite back from $vm"
    failed+=("$suite")
    continue
  fi
  if [[ -d $tmp/logs ]]; then
    mkdir -p "$results/build-$suite"
    cp -rf "$tmp/logs/." "$results/build-$suite/"
  fi
  mkdir -p "$MV_DEBS/$suite"
  shopt -s nullglob
  for f in "$tmp"/*.deb "$tmp"/*.ddeb "$tmp"/*.dsc "$tmp"/*.changes "$tmp"/*.buildinfo "$tmp"/*.tar.*; do
    chmod 0644 "$f"
    mv -f "$f" "$MV_DEBS/$suite/"
    if [[ $f == *.deb ]]; then
      printf '%s\n' "$MV_DEBS/$suite/${f##*/}"
    fi
  done
  shopt -u nullglob
  rm -rf -- "$tmp"
done

if $booted && $keep_vm; then
  mv_log "kept build VM $vm; remove it with: test/vm/down $vm"
fi
mv_log "logs: $results"
if ((${#failed[@]} > 0)); then
  mv_log "build failed for: ${failed[*]}"
  exit 1
fi
mv_log "packages are in $MV_DEBS/"
