#!/bin/bash
# curl stub. Logs the call to $LOGS/curl and copies $FAKE_DOWNLOAD to the
# file given with -o. Exits $FAKE_CURL_RC when it is set.
printf '%s\n' "$*" >>"$LOGS/curl"
if [[ -n ${FAKE_CURL_RC:-} ]]; then
  exit "$FAKE_CURL_RC"
fi
out=""
while (($# > 0)); do
  if [[ $1 == -o && $# -ge 2 ]]; then
    out=$2
    shift
  fi
  shift
done
[[ -n $out ]] || exit 2
cp -- "$FAKE_DOWNLOAD" "$out"
