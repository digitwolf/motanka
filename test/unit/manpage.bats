#!/usr/bin/env bats
# shellcheck disable=SC2329 # setup and helpers are called by bats
# Unit tests for the man page (task 24.5; requirement 12.4): tools/mkman
# converts its Markdown subset as documented, docs/motanka.1 is what
# tools/mkman makes of docs/motanka.1.md, the page documents every command,
# option, exit status and environment variable the CLI has, and man renders
# it without warnings (the check lintian runs) when man is installed.

bats_require_minimum_version 1.5.0

setup() {
  load '../bats/support/load'
  load '../bats/assert/load'
  REPO="$BATS_TEST_DIRNAME/../.."
  MKMAN="$REPO/tools/mkman"
  MOTANKA="$REPO/src/motanka"
  SRC="$REPO/docs/motanka.1.md"
  PAGE="$REPO/docs/motanka.1"
  unset MOTANKA_ROOT SUDO_USER PKEXEC_UID NO_COLOR
}

# help_options <command>: the options 'motanka <command> --help' lists.
help_options() {
  bash "$MOTANKA" "$1" --help |
    sed -n 's/^  \(-[^ ].*\)$/\1/p' |
    sed 's/  .*$//' |
    tr ', ' '\n' |
    grep '^-' |
    LC_ALL=C sort -u
}

# section <heading>: the lines of the Markdown source below "# <heading>"
# or "## <heading>", up to the next heading of the same or a higher level.
section() {
  awk -v h="$1" '
    $0 == "# " h || $0 == "## " h { f = 1; lvl = ($0 ~ /^## /) ? 2 : 1; next }
    f && /^# / { exit }
    f && lvl == 2 && /^## / { exit }
    f { print }
  ' "$SRC"
}

@test "docs/motanka.1 is current with docs/motanka.1.md" {
  run --separate-stderr python3 "$MKMAN" "$SRC" --check "$PAGE"
  assert_success
}

@test "the page has a section for every command of motanka --help" {
  local c
  while IFS= read -r c; do
    grep -qx "## $c" "$SRC" || fail "no '## $c' section in docs/motanka.1.md"
  done < <(bash "$MOTANKA" --help | awk '/^Commands:/ { f = 1; next } f && /^  [a-z]/ { print $1 } f && /^$/ { exit }')
  grep -qx '## help' "$SRC"
}

@test "every option of every command is documented in that command's section" {
  local c o body
  for c in install remove update rollback doctor; do
    body=$(section "$c")
    [[ -n $body ]] || fail "empty section for $c"
    while IFS= read -r o; do
      case $o in
        # In "DEVELOPMENT BUILDS" and "help", for every command.
        --i-know-this-is-not-a-vm | -h | --help) continue ;;
      esac
      grep -qF -- "\`$o\`" <<<"$body" || fail "$c: option $o is not documented in its section"
    done < <(help_options "$c")
  done
  section help | grep -qF -- "\`-h\` and \`--help\`" || fail "the help section does not document -h and --help"
}

@test "the development-build option is documented" {
  run section "DEVELOPMENT BUILDS"
  assert_success
  assert_line "\`--i-know-this-is-not-a-vm\`"
}

@test "every exit status of motanka --help is documented" {
  local n count=0
  while IFS= read -r n; do
    count=$((count + 1))
    section "EXIT STATUS" | grep -qx "\`$n\`" || fail "exit status $n is not documented"
  done < <(bash "$MOTANKA" --help | awk '/^Exit codes:/ { f = 1; next } f && /^ *[0-9]+  / { print $1 }')
  ((count == 13)) || fail "expected 13 exit statuses in motanka --help, found $count"
}

@test "the environment variables the CLI reads are documented" {
  local v body
  body=$(section ENVIRONMENT)
  for v in NO_COLOR MOTANKA_APT_URI SUDO_USER PKEXEC_UID MOTANKA_ROOT; do
    grep -qF -- "\`$v\`" <<<"$body" || fail "$v is not documented"
  done
}

@test "man renders the page without warnings" {
  if ! command -v man >/dev/null 2>&1 || ! command -v groff >/dev/null 2>&1; then
    skip "man or groff is not installed"
  fi
  run --separate-stderr env LC_ALL=C.UTF-8 MANROFFSEQ='' MANWIDTH=80 \
    man --warnings -E UTF-8 -l -Tutf8 -Z "$PAGE"
  assert_success
  [[ -z $stderr ]] || fail "man warnings: $stderr"
}

# --- tools/mkman ----------------------------------------------------------

write_demo() {
  cat >"$BATS_TEST_TMPDIR/demo.1.md" <<'EOF'
% DEMO(1) Demo 1.0 | Demo manual
% Someone
% 2026-01-02

# NAME

demo - a demo

# OPTIONS

`--flag`, `-f`
:   Set the *flag* for **all** runs.
    Second line.

- item one
  more of one
- item two

.starts with a dot

```
literal -x \ line
```
EOF
}

@test "mkman converts title, headings, definitions, items and literal blocks" {
  write_demo
  run --separate-stderr python3 "$MKMAN" "$BATS_TEST_TMPDIR/demo.1.md"
  assert_success
  assert_output "$(
    cat <<'EOF'
.\" Generated by tools/mkman from demo.1.md; do not edit.
.TH "DEMO" "1" "2026\-01\-02" "Demo 1.0" "Demo manual"
.SH NAME
.PP
demo \- a demo
.SH OPTIONS
.TP
\fB\-\-flag\fR, \fB\-f\fR
Set the \fIflag\fR for \fBall\fR runs.
Second line.
.IP \(bu 2
item one
more of one
.IP \(bu 2
item two
.PP
\&.starts with a dot
.PP
.RS 4
.nf
literal \-x \e line
.fi
.RE
EOF
  )"
}

@test "mkman -o writes the same text and --check fails on a stale page" {
  write_demo
  run python3 "$MKMAN" "$BATS_TEST_TMPDIR/demo.1.md" -o "$BATS_TEST_TMPDIR/demo.1"
  assert_success
  run --separate-stderr python3 "$MKMAN" "$BATS_TEST_TMPDIR/demo.1.md" --check "$BATS_TEST_TMPDIR/demo.1"
  assert_success
  printf 'stale\n' >>"$BATS_TEST_TMPDIR/demo.1"
  run --separate-stderr python3 "$MKMAN" "$BATS_TEST_TMPDIR/demo.1.md" --check "$BATS_TEST_TMPDIR/demo.1"
  assert_failure 1
  [[ $output == *'-stale'* ]]
  [[ $stderr == *'is not current'* ]]
}

# mkman_body <line>...: converts a page with these body lines.
mkman_body() {
  {
    printf '%% DEMO(1) Demo | Demo manual\n%%\n%% 2026-01-02\n\n'
    printf '%s\n' "$@"
  } >"$BATS_TEST_TMPDIR/bad.1.md"
  run --separate-stderr python3 "$MKMAN" "$BATS_TEST_TMPDIR/bad.1.md"
}

@test "mkman refuses a stray asterisk" {
  mkman_body '# NAME' '' 'a * b'
  assert_failure 2
  [[ $stderr == *"bad.1.md:7: stray '*'"* ]]
}

@test "mkman refuses an unclosed code span" {
  mkman_body '# NAME' '' 'a `b'
  assert_failure 2
  [[ $stderr == *"unclosed"* ]]
}

@test "mkman refuses an indented line outside a definition or item" {
  mkman_body '# NAME' '' 'text' '  indented'
  assert_failure 2
  [[ $stderr == *"bad.1.md:8: unexpected indentation"* ]]
}

@test "mkman refuses a definition without a term" {
  mkman_body '# NAME' '' ':   orphan'
  assert_failure 2
  [[ $stderr == *"needs its term"* ]]
}

@test "mkman refuses a source without a title block" {
  printf '# NAME\n\ntext\nmore\n' >"$BATS_TEST_TMPDIR/bad.1.md"
  run --separate-stderr python3 "$MKMAN" "$BATS_TEST_TMPDIR/bad.1.md"
  assert_failure 2
  [[ $stderr == *"bad.1.md:1: expected"* ]]
}
