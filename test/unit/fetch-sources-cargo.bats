#!/usr/bin/env bats
# shellcheck disable=SC2329 # setup and helpers are called by bats
# Unit tests for the cargo components of stack/fetch-sources (task 7.9;
# requirements 7.2, 7.3, 8.1): Cargo.lock is read from the component
# tarball, every crates.io crate is downloaded, checked against the lock
# file's SHA-256 and packed into a reproducible orig-<name>-crates tarball.
# The component tarball is put into the download cache beforehand (with
# its pinned SHA-256, so it is "cached"), and the crates are downloaded
# through a file:// MOTANKA_CRATES_BASE_URL, so nothing leaves the VM.

bats_require_minimum_version 1.5.0

setup() {
  load '../bats/support/load'
  load '../bats/assert/load'
  REPO="$BATS_TEST_DIRNAME/../.."
  FETCH="$REPO/stack/fetch-sources"
  T=$BATS_TEST_TMPDIR
  OUT=$T/out
  SRV=$T/crates
  export MOTANKA_CRATES_BASE_URL="file://$SRV"
  CRATES_TGZ=$OUT/orig/motanka-test_1.0.0.orig-demo-crates.tar.gz
  mkdir -p "$SRV" "$OUT/downloads"
}

# sha <file>: its SHA-256.
sha() {
  sha256sum <"$1" | cut -c1-64
}

# make_crate <name> <version>: writes $SRV/<name>/<name>-<version>.crate with
# Cargo.toml and src/lib.rs below <name>-<version>/ and prints its SHA-256.
make_crate() {
  local n=$1 v=$2 b=$T/crate-src
  rm -rf "$b"
  mkdir -p "$b/$n-$v/src" "$SRV/$n"
  printf '[package]\nname = "%s"\nversion = "%s"\nedition = "2021"\n' "$n" "$v" >"$b/$n-$v/Cargo.toml"
  printf 'pub fn f_%s() {}\n' "${v//./_}" >"$b/$n-$v/src/lib.rs"
  chmod 0644 "$b/$n-$v/Cargo.toml" "$b/$n-$v/src/lib.rs"
  chmod 0755 "$b/$n-$v" "$b/$n-$v/src"
  tar -C "$b" -czf "$SRV/$n/$n-$v.crate" "$n-$v"
  sha "$SRV/$n/$n-$v.crate"
}

# registry <name> <version> <sha256>: a crates.io [[package]] entry.
registry() {
  printf '[[package]]\nname = "%s"\nversion = "%s"\nsource = "registry+https://github.com/rust-lang/crates.io-index"\nchecksum = "%s"\n\n' "$1" "$2" "$3"
}

# good_lock: $T/lock with the Cargo.lock entries of three crates (two
# versions of alpha, and beta) and a repeated entry of alpha 0.1.0.
good_lock() {
  local a1 a2 b
  a1=$(make_crate alpha 0.1.0)
  a2=$(make_crate alpha 0.2.0)
  b=$(make_crate beta 1.0.0)
  {
    registry alpha 0.1.0 "$a1"
    registry alpha 0.2.0 "$a2"
    registry beta 1.0.0 "$b"
    registry alpha 0.1.0 "$a1"
  } >"$T/lock"
}

# make_component [<entries file>|-]: the cargo component demo 1.0.0. Its
# tarball holds Cargo.toml, src/main.rs and, unless '-', a Cargo.lock with
# the given entries plus demo itself (no source: the workspace's own
# package). It is put into the download cache, and $T/c.tsv pins it.
make_component() {
  local b=$T/comp
  rm -rf "$b"
  mkdir -p "$b/demo-1.0.0/src"
  printf '[package]\nname = "demo"\nversion = "1.0.0"\nedition = "2021"\n' >"$b/demo-1.0.0/Cargo.toml"
  printf 'fn main() {}\n' >"$b/demo-1.0.0/src/main.rs"
  if [[ ${1:--} != - ]]; then
    {
      printf '# This file is automatically @generated by Cargo.\nversion = 4\n\n'
      cat "$1"
      printf '[[package]]\nname = "demo"\nversion = "1.0.0"\n'
    } >"$b/demo-1.0.0/Cargo.lock"
  fi
  tar -C "$b" -czf "$OUT/downloads/demo-1.0.0.tar.gz" demo-1.0.0
  printf '#@source motanka-test\n#@packages motanka-test\ndemo\t1.0.0\thttps://example.test/demo-1.0.0.tar.gz\t%s\tcargo\tboth\tmotanka-test\n' \
    "$(sha "$OUT/downloads/demo-1.0.0.tar.gz")" >"$T/c.tsv"
}

fetch() {
  run python3 "$FETCH" --components "$T/c.tsv" --out "$OUT" --version 1.0.0
}

# check_meta <tarball>: prints "ok" if the gzip header has mtime 0 and no
# file name, and every member has mtime 0, owner and group 0 with empty
# names, folders mode 0755, Cargo.toml files mode 0644, members sorted by
# path.
check_meta() {
  python3 - "$1" <<'EOF'
import sys, tarfile
with open(sys.argv[1], "rb") as f:
    head = f.read(10)
assert head[:2] == b"\x1f\x8b", "not gzip"
assert head[3] & 0x08 == 0, "the gzip header has a file name"
assert head[4:8] == b"\0\0\0\0", "the gzip header mtime is not 0"
names = []
with tarfile.open(sys.argv[1], "r:gz") as tar:
    for m in tar:
        assert (m.mtime, m.uid, m.gid, m.uname, m.gname) == (0, 0, 0, "", ""), m.name
        assert m.isdir() or m.isfile(), m.name
        if m.isdir():
            assert m.mode == 0o755, (m.name, oct(m.mode))
        elif m.name.endswith("/Cargo.toml"):
            assert m.mode == 0o644, (m.name, oct(m.mode))
        names.append(m.name.rstrip("/").split("/"))
assert names == sorted(names), "members are not sorted by path"
print("ok")
EOF
}

@test "the crates of Cargo.lock are verified and packed into the orig-demo-crates component" {
  local f
  good_lock
  make_component "$T/lock"
  fetch
  assert_success
  assert_equal "${lines[-1]}" "$OUT/orig"
  assert_output --partial 'demo: 3 crates of Cargo.lock verified (3 downloaded, 0 cached)'
  assert_output --partial 'demo: 3 crates packed into motanka-test_1.0.0.orig-demo-crates.tar.gz'
  [[ -f $OUT/orig/motanka-test_1.0.0.orig-demo.tar.gz ]] || fail "the component tarball is not laid out"
  for f in alpha-0.1.0 alpha-0.2.0 beta-1.0.0; do
    [[ -f $OUT/downloads/crates/$f.crate ]] || fail "$f.crate is not cached"
  done
  run tar -tzf "$CRATES_TGZ"
  assert_success
  assert_output "$(
    printf '%s\n' demo-crates/
    for f in alpha-0.1.0 alpha-0.2.0 beta-1.0.0; do
      printf 'demo-crates/%s%s\n' "$f" / "$f" /.cargo-checksum.json "$f" /Cargo.toml "$f" /src/ "$f" /src/lib.rs
    done
  )"
  run tar -xzOf "$CRATES_TGZ" demo-crates/beta-1.0.0/.cargo-checksum.json
  assert_output "{\"files\":{},\"package\":\"$(sha "$SRV/beta/beta-1.0.0.crate")\"}"
  tar -xzOf "$SRV/alpha/alpha-0.2.0.crate" alpha-0.2.0/src/lib.rs >"$T/want.rs"
  tar -xzOf "$CRATES_TGZ" demo-crates/alpha-0.2.0/src/lib.rs >"$T/got.rs"
  run cmp "$T/want.rs" "$T/got.rs"
  assert_success
}

@test "two runs write byte-identical crates tarballs with fixed metadata" {
  good_lock
  make_component "$T/lock"
  fetch
  assert_success
  cp "$CRATES_TGZ" "$T/first.tar.gz"
  rm -rf "$OUT/orig" "$OUT/downloads/crates"
  fetch
  assert_success
  run cmp "$T/first.tar.gz" "$CRATES_TGZ"
  assert_success
  run check_meta "$CRATES_TGZ"
  assert_output ok
}

@test "cached crates are reused, and a cached crate that does not match Cargo.lock is downloaded again" {
  good_lock
  make_component "$T/lock"
  fetch
  assert_success
  fetch
  assert_success
  assert_output --partial '(0 downloaded, 3 cached)'
  printf 'junk' >"$OUT/downloads/crates/alpha-0.2.0.crate"
  fetch
  assert_success
  assert_output --partial 'cached crate alpha-0.2.0 does not match Cargo.lock; downloading again'
  assert_output --partial '(1 downloaded, 2 cached)'
}

@test "a crate whose SHA-256 differs from Cargo.lock exits 6 and writes no crates tarball" {
  good_lock
  sed -i "s/$(sha "$SRV/beta/beta-1.0.0.crate")/$(printf 'other' | sha256sum | cut -c1-64)/" "$T/lock"
  make_component "$T/lock"
  fetch
  assert_failure 6
  assert_output --partial 'crate beta-1.0.0: sha256'
  assert_output --partial "does not match Cargo.lock's"
  [[ ! -e $OUT/downloads/crates/beta-1.0.0.crate ]] || fail "the mismatching crate was kept"
  [[ ! -e $CRATES_TGZ ]] || fail "a crates tarball was written"
  [[ ! -e $OUT/orig/motanka-test_1.0.0.orig-demo.tar.gz ]] || fail "the orig components were laid out"
}

@test "a package from a git source exits 1" {
  good_lock
  printf '[[package]]\nname = "gamma"\nversion = "0.3.0"\nsource = "git+https://example.test/gamma.git?rev=0123abc#0123abc"\n\n' >>"$T/lock"
  make_component "$T/lock"
  fetch
  assert_failure 1
  assert_output --partial 'gamma 0.3.0 comes from a git source'
  [[ ! -e $CRATES_TGZ ]] || fail "a crates tarball was written"
  [[ ! -e $OUT/downloads/crates ]] || fail "crates were downloaded"
}

@test "a package from another registry exits 1" {
  good_lock
  printf '[[package]]\nname = "delta"\nversion = "1.2.3"\nsource = "registry+https://example.test/index"\nchecksum = "%s"\n\n' \
    "$(printf 'x' | sha256sum | cut -c1-64)" >>"$T/lock"
  make_component "$T/lock"
  fetch
  assert_failure 1
  assert_output --partial 'delta 1.2.3 comes from a non-crates.io source'
}

@test "a path dependency outside the tarball exits 1" {
  good_lock
  printf '[[package]]\nname = "outside"\nversion = "0.1.0"\n\n' >>"$T/lock"
  make_component "$T/lock"
  fetch
  assert_failure 1
  assert_output --partial 'outside 0.1.0 has no source, and no Cargo.toml in the tarball declares it'
}

@test "a cargo component without Cargo.lock exits 1" {
  make_component -
  fetch
  assert_failure 1
  assert_output --partial 'demo: the tarball has no Cargo.lock in its top folder'
}

@test "a crate with a member outside its folder exits 1" {
  local b=$T/evil
  mkdir -p "$b/alpha-0.1.0" "$SRV/alpha"
  printf '[package]\nname = "alpha"\nversion = "0.1.0"\n' >"$b/alpha-0.1.0/Cargo.toml"
  printf 'x\n' >"$b/stray.txt"
  tar -C "$b" -czf "$SRV/alpha/alpha-0.1.0.crate" alpha-0.1.0 stray.txt
  registry alpha 0.1.0 "$(sha "$SRV/alpha/alpha-0.1.0.crate")" >"$T/lock"
  make_component "$T/lock"
  fetch
  assert_failure 1
  assert_output --partial "crate alpha-0.1.0: member 'stray.txt' is outside the folder alpha-0.1.0/"
  [[ ! -e $CRATES_TGZ ]] || fail "a crates tarball was written"
}

@test "stale crates tarballs of the source are removed, other sources' files are kept" {
  good_lock
  make_component "$T/lock"
  mkdir -p "$OUT/orig"
  printf 'old\n' >"$OUT/orig/motanka-test_0.9.0.orig-demo-crates.tar.gz"
  printf 'other\n' >"$OUT/orig/motanka-other_1.0.0.orig-x.tar.gz"
  fetch
  assert_success
  [[ ! -e $OUT/orig/motanka-test_0.9.0.orig-demo-crates.tar.gz ]] || fail "the stale crates tarball is still there"
  [[ -f $OUT/orig/motanka-other_1.0.0.orig-x.tar.gz ]] || fail "another source package's file was removed"
  [[ -f $CRATES_TGZ ]]
}

@test "--check validates a cargo components file without network and writes nothing" {
  make_component -
  run env MOTANKA_CRATES_BASE_URL=https://crates.invalid https_proxy=http://127.0.0.1:9 http_proxy=http://127.0.0.1:9 \
    python3 "$FETCH" --components "$T/c.tsv" --out "$T/never" --version 1.0.0 --check
  assert_success
  assert_output --partial '1 components, valid (source motanka-test)'
  [[ ! -e $T/never ]] || fail "--check wrote into the output folder"
}

@test "a component named like a cargo component's crates component is rejected" {
  make_component -
  printf 'demo-crates\t1.0.0\thttps://example.test/x.tar.gz\t-\tsource\tboth\t-\n' >>"$T/c.tsv"
  run python3 "$FETCH" --components "$T/c.tsv" --check
  assert_failure 2
  assert_output --partial "'demo-crates', which the file also lists"
}

@test "a crates base URL that is neither https nor file is a usage error" {
  good_lock
  make_component "$T/lock"
  MOTANKA_CRATES_BASE_URL=http://example.test fetch
  assert_failure 2
  assert_output --partial 'MOTANKA_CRATES_BASE_URL must be an https:// or file:// URL'
}
